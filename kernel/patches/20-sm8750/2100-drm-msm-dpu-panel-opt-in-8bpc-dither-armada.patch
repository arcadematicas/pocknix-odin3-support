From: enjihn <150061999+enjihn@users.noreply.github.com> [Pocknix port]
Subject: [PATCH] drm/msm/dpu: let panels opt in to 8bpc output dithering

Pocknix port of the ArmadaOS patch
`0049-drm-msm-dpu-panel-opt-in-8bpc-dither.patch`
(armada-os/armada, packages/kernel/patches/).

WHY THE RENUMBERING
-------------------
ArmadaOS numbers its patch set independently of ours, and the numbers collide:
armada `0049` is this dither patch, while OUR `0049` is
`0049-drm-msm-a8xx-add-adreno-830-catalog.patch`. Compare by function, never
by number. It is filed here as `2100-` so it sorts after the whole `20-sm8750`
stack and keeps the provenance visible in the filename.

The DPU helper disables output dithering for 8bpc panels, so the 10-bit
pipeline is hard-truncated at the panel interface and dark gradients band
visibly, most of all with HDR content. Enable the existing static ordered
dither matrix at 8bpc for panels that ask for it. Temporal dithering stays
disabled and the 6bpc and default paths are unchanged.

ADAPTATION
----------
The logic is ArmadaOS' byte for byte. Only the context lines and hunk headers
differ, and they were regenerated against the EXACT source state this patch
sees when scripts/build-kernel.sh runs it, i.e. linux-7.2.6 + 05-speedup +
10-mainline + 20-sm8750 (this patch excluded) and *no* 30-version yet. That
ordering detail is load-bearing:

  * `20-sm8750` sorts before `30-version`, so this patch is applied BEFORE
    `0010-msm-resource-cleanup.patch`. That 30-version patch rewrites the
    loop above the dither call from
        for (i = 0; i < MAX_CHANNELS_PER_ENC; i++)
    to
        for (i = 0; i < ARRAY_SIZE(dpu_enc->hw_pp); i++)
    and shifts dpu_encoder.c by 53 lines. ArmadaOS' own hunk 4 and any diff
    taken against a post-30-version tree therefore carry the wrong context
    (`ARRAY_SIZE(...)`) and hunk 4 rejects here.
  * Hunk 2/3 land 2 lines high in our tree because of our own `20-sm8750`
    DPU work; the headers below already account for that.

Verified with `patch -p1 --fuzz=0 --dry-run`: all 4 hunks apply at their
stated line numbers, zero offset, zero fuzz.

To actually get the dither on the Odin 3 the panel node must carry
`armada,dpu-8bpc-dither`; that DTS property is set in
kernel/dts/cq8725s-ayn-common.dtsi, in &display_panel.

Signed-off-by: enjihn <150061999+enjihn@users.noreply.github.com>
---diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -10,9 +10,11 @@
 #define pr_fmt(fmt)	"[drm:%s:%d] " fmt, __func__, __LINE__
 #include <linux/debugfs.h>
 #include <linux/kthread.h>
+#include <linux/of.h>
 #include <linux/seq_file.h>
 
 #include <drm/drm_atomic.h>
+#include <drm/drm_bridge.h>
 #include <drm/drm_crtc.h>
 #include <drm/drm_file.h>
 #include <drm/drm_probe_helper.h>
@@ -384,7 +386,28 @@
 	return entries_added;
 }
 
-static void _dpu_encoder_setup_dither(struct dpu_hw_pingpong *hw_pp, unsigned bpc)
+/*
+ * The DPU disables output dithering at 8bpc, but a panel fed from the 10-bit
+ * pipeline can visibly band without it. Boards opt in per panel with the
+ * armada,dpu-8bpc-dither devicetree property on the panel node.
+ */
+static bool dpu_encoder_panel_dithers_8bpc(struct drm_encoder *drm_enc)
+{
+	struct drm_bridge *last = drm_bridge_chain_get_last_bridge(drm_enc);
+	bool dithers;
+
+	if (!last)
+		return false;
+
+	dithers = last->of_node &&
+		of_property_read_bool(last->of_node, "armada,dpu-8bpc-dither");
+	drm_bridge_put(last);
+
+	return dithers;
+}
+
+static void _dpu_encoder_setup_dither(struct dpu_hw_pingpong *hw_pp, unsigned bpc,
+				      bool panel_dithers_8bpc)
 {
 	struct dpu_hw_dither_cfg dither_cfg = { 0 };
 
@@ -399,6 +422,17 @@
 		dither_cfg.c3_bitdepth = 6;
 		dither_cfg.temporal_en = 0;
 		break;
+	case 8:
+		if (!panel_dithers_8bpc) {
+			hw_pp->ops.setup_dither(hw_pp, NULL);
+			return;
+		}
+		dither_cfg.c0_bitdepth = 8;
+		dither_cfg.c1_bitdepth = 8;
+		dither_cfg.c2_bitdepth = 8;
+		dither_cfg.c3_bitdepth = 8;
+		dither_cfg.temporal_en = 0;
+		break;
 	default:
 		hw_pp->ops.setup_dither(hw_pp, NULL);
 		return;
@@ -1301,10 +1335,12 @@
 	if (dpu_enc->disp_info.intf_type == INTF_DSI &&
 			!WARN_ON(dpu_enc->num_phys_encs == 0)) {
 		unsigned bpc = dpu_enc->connector->display_info.bpc;
+		bool panel_dithers_8bpc = dpu_encoder_panel_dithers_8bpc(drm_enc);
 		for (i = 0; i < MAX_CHANNELS_PER_ENC; i++) {
 			if (!dpu_enc->hw_pp[i])
 				continue;
-			_dpu_encoder_setup_dither(dpu_enc->hw_pp[i], bpc);
+			_dpu_encoder_setup_dither(dpu_enc->hw_pp[i], bpc,
+						  panel_dithers_8bpc);
 		}
 	}
 }
