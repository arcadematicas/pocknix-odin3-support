+static unsigned int qcom_battmgr_estimate_percent(struct qcom_battmgr *battmgr)
+{
+	struct power_supply_battery_info *bat_info;
+	unsigned int v, vmin, vmax;
+	int i;
+
+	/* Curva de descarga generica Li-ion de alta tension (vmax 4.48V) en reposo.
+	 * Pares {microvoltios, porcentaje}. El voltaje OCV en circuito abierto es la
+	 * unica medida fiable con la firmware Debug_Board (sin gauge real): el coulomb
+	 * counter puede quedarse congelado y reportar un % falso. */
+	static const struct {
+		unsigned int uv;
+		unsigned int pct;
+	} ocv_table[] = {
+		{ 4480000, 100 },
+		{ 4400000, 100 },
+		{ 4350000,  95 },
+		{ 4300000,  90 },
+		{ 4250000,  84 },
+		{ 4200000,  78 },
+		{ 4100000,  68 },
+		{ 4000000,  58 },
+		{ 3900000,  48 },
+		{ 3800000,  36 },
+		{ 3700000,  24 },
+		{ 3600000,  13 },
+		{ 3500000,   6 },
+		{ 3400000,   0 },
+	};
+
+	if (power_supply_get_battery_info(battmgr->bat_psy, &bat_info))
+		return 100;
+
+	/* Preferir OCV (circuito abierto, estable); si el firmware aun no lo ha
+	 * reportado, usar el voltaje instantaneo. */
+	if (battmgr->status.voltage_ocv)
+		v = battmgr->status.voltage_ocv;
+	else
+		v = battmgr->status.voltage_now;
+
+	vmin = bat_info->voltage_min_design_uv;
+	vmax = bat_info->voltage_max_design_uv;
+	power_supply_put_battery_info(battmgr->bat_psy, bat_info);
+
+	/* Fuera de rango: saturar a 0/100%. */
+	if (vmin && v <= vmin)
+		return 0;
+	if (vmax && v >= vmax)
+		return 100;
+
+	/* Interpolacion lineal entre los puntos de la tabla. */
+	for (i = 1; i < ARRAY_SIZE(ocv_table); i++) {
+		if (v >= ocv_table[i].uv) {
+			unsigned int v_hi = ocv_table[i - 1].uv;
+			unsigned int p_hi = ocv_table[i - 1].pct;
+			unsigned int v_lo = ocv_table[i].uv;
+			unsigned int p_lo = ocv_table[i].pct;
+
+			if (v_hi <= v_lo)
+				return p_lo;
+			return p_lo + (v - v_lo) * (p_hi - p_lo) / (v_hi - v_lo);
+		}
+	}
+	return 0;
+}
