+static unsigned int qcom_battmgr_estimate_percent(struct qcom_battmgr *battmgr)
+{
+	struct power_supply_battery_info *bat_info;
+	unsigned int percent = (unsigned int)-1;
+
+	if (power_supply_get_battery_info(battmgr->bat_psy, &bat_info))
+		return percent;
+
+	if (bat_info->charge_full_design_uah > 0 &&
+	    battmgr->info.charge_count > 0 &&
+	    battmgr->info.charge_count <= bat_info->charge_full_design_uah) {
+		percent = battmgr->info.charge_count * 100 /
+			  bat_info->charge_full_design_uah;
+	} else if (bat_info->voltage_min_design_uv > 0 &&
+		   bat_info->voltage_max_design_uv > bat_info->voltage_min_design_uv) {
+		unsigned int v = battmgr->status.voltage_now;
+		unsigned int vmin = bat_info->voltage_min_design_uv;
+		unsigned int vmax = bat_info->voltage_max_design_uv;
+
+		if (v <= vmin)
+			v = vmin;
+		if (v >= vmax)
+			v = vmax;
+		percent = (v - vmin) * 100 / (vmax - vmin);
+	}
+
+	power_supply_put_battery_info(battmgr->bat_psy, bat_info);
+	return percent;
+}
