#!/bin/bash
# pocknix-hdr-restore — aplica el estado de HDR que manda el Panel de Control.
#
# El atomo vive en el Xwayland de gamescope (:0) y solo lo puede tocar `deck`.
# Fuente de verdad: el perfil de color del Panel de Control (Hooandee):
#   /home/deck/homebrew/settings/Panel de Control/color.json
# (global.hdr, o games.<appid>.hdr si el juego no sigue al global). Si el panel
# no existe, cae a /var/lib/pocknix/hdr-enabled y a POCKNIX_HDR_DEFAULT.
#
# Se ejecuta al arrancar la sesion y al despertar (Steam pone el atomo a 1 al
# iniciar/resumir; por eso se aplica varias veces).
set -u
STORE="${POCKNIX_HDR_STORE:-/home/deck/homebrew/settings/Panel de Control/color.json}"
PREF=/var/lib/pocknix/hdr-enabled
DEF_CFG=/etc/pocknix/hdr.conf
ATOM=GAMESCOPE_DISPLAY_HDR_ENABLED
FOCUS_ATOMS="GAMESCOPE_FOCUSED_APP_GFX GAMESCOPE_FOCUSED_APP"

xprop_deck() { runuser -u deck -- env DISPLAY=:0 xprop "$@" 2>/dev/null; }

# 1) esperar al atomo (hasta 3 min: la sesion tarda en levantar)
v=""
for _ in $(seq 1 90); do
  v="$(xprop_deck -root "$ATOM" | grep -oE '[01]$' | head -1)"
  [ -n "${v:-}" ] && break
  sleep 2
done
if [ -z "${v:-}" ]; then
  echo "pocknix-hdr-restore: sin atomo $ATOM (¿sin sesion gamescope?)"
  exit 0
fi

# 2) appid enfocado (vacio = scope global). Al resumir puede tardar unos segundos.
appid=""
for _ in $(seq 1 8); do
  for a in $FOCUS_ATOMS; do
    appid="$(xprop_deck -root "$a" | grep -oE '=[[:space:]]*[0-9]+' | grep -oE '[0-9]+' | head -1)"
    [ -n "${appid:-}" ] && [ "${appid}" != "0" ] && break 2
    appid=""
  done
  sleep 2
done

# 3) estado deseado segun el Panel de Control
want=""
if [ -r "$STORE" ] && command -v python3 >/dev/null 2>&1; then
  want="$(python3 - "$STORE" "${appid:-}" <<'PY' 2>/dev/null
import json, sys
store, appid = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(store))
except Exception:
    sys.exit(1)
glob = bool((data.get("global") or {}).get("hdr"))
if appid:
    game = (data.get("games") or {}).get(str(appid))
    want = bool(game.get("hdr")) if isinstance(game, dict) and not game.get("follow_global") else glob
else:
    want = glob
print(1 if want else 0)
PY
)"
fi

# 4) respaldo: preferencia de PocknixControl o el defecto de hdr.conf
if [ -z "${want:-}" ]; then
  want_default="0"
  [ -f "$DEF_CFG" ] && grep -qE '^POCKNIX_HDR_DEFAULT=on' "$DEF_CFG" && want_default="1"
  want="$want_default"
  [ -f "$PREF" ] && want="$(tr -d '[:space:]' < "$PREF" 2>/dev/null)"
  case "$want" in 0|1) ;; *) want="$want_default" ;; esac
fi

# 5) aplicar (Steam puede reescribirlo al arrancar/resumir: varias pasadas)
apply() { xprop_deck -root -f "$ATOM" 32c -set "$ATOM" "$1" >/dev/null 2>&1; }
apply "$want"; sleep 5; apply "$want"; sleep 5; apply "$want"
echo "pocknix-hdr-restore: HDR=$want appid=${appid:-global}"
