#!/usr/bin/env python3
"""pocknix-panel-control-patch — re-aplica `hdr=True` al perfil `ayn_odin3`.

POR QUE EXISTE
  El plugin Decky "Panel de Control" (Hooandee, /home/deck/homebrew/plugins/Panel de
  Control) SE AUTOACTUALIZA desde GitHub con su propio boton (py_modules/self_updater.py):
  descarga el zip de la ultima release y lo copia ENCIMA del plugin instalado. En cada
  release vuelve `py_modules/device_profiles.py` SIN `hdr=True` en el perfil `ayn_odin3`
  (el PR #947 a Hooandee sigue pendiente), y entonces la UI deja de dibujar el bloque HDR:
  `src/sections/displayBlocks.tsx` hace `if (!hdr.state?.supported) return null;`.

  El estado HDR del ARRANQUE lo sigue fijando pocknix-hdr-restore (SDR por defecto); este
  script NO toca ese diseño. Solo se asegura de que el TOGGLE del plugin (el que manda,
  decision de Fransis 16/10) exista, para que el usuario pueda encenderlo.

QUE HACE (idempotente)
  1. Si el fichero no existe -> no hace nada (el plugin aun no esta instalado).
  2. Localiza la llamada `DeviceProfile(...)` del perfil `ayn_odin3` con el AST de Python
     (no un sed fragil: respeta multilinea, comillas y parentesis anidados).
  3. Si ya tiene un argumento `hdr=` -> no toca nada (idempotente) y sale con 0.
  4. Si no -> inserta `, hdr=True` JUSTO DESPUES del ultimo argumento de la llamada
     (siempre genera Python valido, sea cual sea el ultimo kwarg: posicional o keyword).
  5. Deja un backup `.orig` (la copia SIN parchear que se va a reemplazar).
  6. Borra el `__pycache__/device_profiles*.pyc` para que el siguiente import recompile.

NO reinicia Decky: solo deja el fichero correcto para el SIGUIENTE arranque del loader
(reiniciar el loader en modo juego crashea steamwebhelper; es un crasheo conocido).

Se lanza desde pocknix-panel-control-patch.path (vigila el fichero), al arranque (la
unidad .service esta wanted) y por el timer de respaldo (cada 15 min).
"""

from __future__ import annotations

import ast
import glob
import os
import shutil
import subprocess
import sys
import syslog
import tempfile

DEFAULT_FILE = "/home/deck/homebrew/plugins/Panel de Control/py_modules/device_profiles.py"
PROFILE_KEY = "ayn_odin3"
NEEDLE = "DFL.staticClasses.Title"
FIXED = "DFL?.staticClasses?.Title"
_TAG = "pocknix-panel-control-patch"


def log(msg: str) -> None:
    # stdout lo captura el journal (Type=oneshot); syslog da ademas el tag buscable.
    print(f"{_TAG}: {msg}", flush=True)
    try:
        syslog.syslog(syslog.LOG_INFO, msg)
    except Exception:  # noqa: BLE001 — el journal es best-effort
        pass


def _is_profile_call(node: ast.AST) -> bool:
    """True si `node` es `DeviceProfile(...)` y su primer dato de identidad es ayn_odin3.

    Acepta el estilo posicional (`DeviceProfile("ayn_odin3", ...)`) y el de keyword
    (`DeviceProfile(key="ayn_odin3", ...)`).
    """
    if not isinstance(node, ast.Call):
        return False
    func = node.func
    if not (isinstance(func, ast.Name) and func.id == "DeviceProfile"):
        return False
    firsts = list(node.args) + [kw.value for kw in node.keywords]
    for first in firsts[:1]:  # solo el primer argumento posicional o el primer kw
        if isinstance(first, ast.Constant) and first.value == PROFILE_KEY:
            return True
    for kw in node.keywords:
        if kw.arg == "key" and isinstance(kw.value, ast.Constant) and kw.value.value == PROFILE_KEY:
            return True
    return False


def _end_offset(line_starts: list[int], node: ast.AST) -> int:
    """Offset (absoluto en el fichero) del final del token `node` (justo tras el)."""
    return line_starts[node.end_lineno - 1] + node.end_col_offset


def patch_file(path: str) -> int:
    """Devuelve 0 si todo OK (cambiado o no), 1 si no se pudo parsear/escribir."""
    if not os.path.isfile(path):
        log(f"no existe {path!r} (el plugin no esta instalado): nada que hacer")
        return 0

    try:
        with open(path, encoding="utf-8") as fh:
            src = fh.read()
    except OSError as exc:
        log(f"ERROR leyendo {path!r}: {exc}")
        return 1

    try:
        tree = ast.parse(src, filename=path)
    except SyntaxError as exc:
        # Fichero a medias (el updater copiando) o upstream roto: NO tocamos nada; el timer
        # de respaldo lo reintenta. Devolvemos !=0 para que quede en el journal.
        log(f"ERROR parseando {path!r} (¿escritura en curso?): {exc}")
        return 1

    call = next((n for n in ast.walk(tree) if _is_profile_call(n)), None)
    if call is None:
        log(f"aviso: no encontre la llamada DeviceProfile(\"{PROFILE_KEY}\") en {path!r}")
        return 0

    if any(kw.arg == "hdr" for kw in call.keywords):
        log(f"ok: {PROFILE_KEY} ya tiene hdr -> sin cambios")
        return 0

    # Ultimo argumento de la llamada EN ORDEN DE FUENTE. Usamos el nodo expr: para un
    # kwarg es kw.value (que termina el kwarg) y para un posicional es el propio argumento.
    # Insertamos `, hdr=True` DESPUES de el (nunca antes del `nombre=` de un kwarg).
    args = list(call.args) + [kw.value for kw in call.keywords]
    if not args:
        log(f"ERROR: DeviceProfile(\"{PROFILE_KEY}\") sin argumentos; no se donde insertar hdr")
        return 1
    last = max(args, key=lambda n: (n.end_lineno, n.end_col_offset))

    line_starts = [0]
    for line in src.splitlines(keepends=True):
        line_starts.append(line_starts[-1] + len(line))
    pos = _end_offset(line_starts, last)

    new_src = src[:pos] + ", hdr=True" + src[pos:]

    # Validacion final: el resultado DEBE seguir siendo Python valido. Si no, abortamos.
    try:
        ast.parse(new_src, filename=path)
    except SyntaxError as exc:
        log(f"ERROR: el resultado no seria Python valido, NO escribo: {exc}")
        return 1

    # Backup de la copia SIN parchear (refresca .orig en cada aplicacion).
    backup = path + ".orig"
    try:
        shutil.copy2(path, backup)
    except OSError as exc:
        log(f"ERROR creando backup {backup!r}: {exc}")
        return 1

    # Escritura atomica: temp en el MISMO directorio + os.replace, conservando modo y owner.
    st = os.stat(path)
    directory = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(prefix=".device_profiles.", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(new_src)
        os.chmod(tmp, st.st_mode & 0o7777)
        try:
            if hasattr(os, "chown"):
                os.chown(tmp, st.st_uid, st.st_gid)
        except OSError:
            pass  # sin privilegios para chown: lo deja como root, que es lo correcto igual
        os.replace(tmp, path)
    except OSError as exc:
        log(f"ERROR escribiendo {path!r}: {exc}")
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return 1

    # Invalida la cache de bytecode (por si el .pyc quedara con mtime >= el nuevo).
    pyc_dir = os.path.join(directory, "__pycache__")
    for pyc in glob.glob(os.path.join(pyc_dir, "device_profiles*.pyc")):
        try:
            os.unlink(pyc)
        except OSError:
            pass

    log(f"APLICADO: hdr=True anadido al perfil {PROFILE_KEY} en {path!r} (backup: {backup!r})")
    return 0


def patch_frontend(plugin_dir: str) -> int:
    """Parchea dist/index.js: `DFL.staticClasses.Title` -> `DFL?.staticClasses?.Title`.

    POR QUE: Steam actualizo su cliente (17/10/2026) y el QAM paso a vistas CEF propias
    (QuickAccess_uid2 / MainMenu_uid2). En el cliente nuevo `DFL.staticClasses` ya no
    existe, y el plugin registra su pestana del QAM con
    `title: jsx('div', {className: DFL.staticClasses.Title, ...})` -> TypeError
    "Cannot read properties of undefined (reading 'Title')" -> la pestana NO se registra
    y el Panel de Control DESAPARECE del QAM. Con optional chaining el className queda
    undefined y la pestana vuelve a registrarse (lo unico que se pierde es esa clase CSS).
    """
    p = os.path.join(plugin_dir, "dist", "index.js")
    if not os.path.isfile(p):
        log(f"no existe {p!r}: nada que hacer en el frontend")
        return 0
    try:
        with open(p, encoding="utf-8", errors="surrogateescape") as fh:
            src = fh.read()
    except OSError as exc:
        log(f"ERROR leyendo {p!r}: {exc}")
        return 1

    if NEEDLE not in src:
        log("ok: frontend sin DFL.staticClasses (nada que parchear)")
        return 0

    backup = p + ".orig-frontend"
    if not os.path.exists(backup):
        try:
            shutil.copy2(p, backup)
        except OSError as exc:
            log(f"ERROR creando backup {backup!r}: {exc}")
            return 1
    n = src.count(NEEDLE)
    tmp = p + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as fh:
            fh.write(src.replace(NEEDLE, FIXED))
        os.replace(tmp, p)
    except OSError as exc:
        log(f"ERROR escribiendo {p!r}: {exc}")
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return 1
    log(f"APLICADO: frontend parcheado ({n} refs) en {p!r} (backup: {backup!r})")
    return 0


ARM64_PATCH = "/usr/share/pocknix/patches/panel-de-control-arm64-mako.patch"

ENGINE4_OLD = """                line = options['engine']
                self._verify_install(state, line)
"""
ENGINE4_NEW = """                line = options['engine']
                if _arm() and line == 4:
                    line = 5   # en ARM no hay renderer v4: todo va por la linea 5
                self._verify_install(state, line)
"""

# Puente entre power-profiles-daemon (selector de Plasma) y el nivel TDP del panel.
POWER_BRIDGE_PY = r'''"""Puente entre los perfiles de energia de KDE (power-profiles-daemon) y el nivel TDP.

En la Odin ppd arranca con el driver "fake": el selector de Plasma no toca nada. Este
modulo lee el perfil activo de ppd (busctl, sin dependencias) y lo traduce a un nivel
del backend arm-frequency-levels llamando a la API del propio plugin
(set_tdp_watts(level, "global")), de modo que el guardian y el perfil guardado siguen
en sync.

Instalado por /usr/local/bin/pocknix-panel-control-patch (no viene de upstream).
Config opcional: /etc/calvos/power-bridge.json  {"levels": {"balanced": 6, ...}}
"""
import asyncio
import json
import os
import shutil
import subprocess
import threading

DEFAULT_LEVELS = {"power-saver": 3, "balanced": 6, "performance": 10}
CONFIG_PATHS = ("/etc/calvos/power-bridge.json",)
POLL_S = 2.0
BUSCTL = shutil.which("busctl") or "/usr/bin/busctl"
DEST = "net.hadess.PowerProfiles"
PATH = "/net/hadess/PowerProfiles"
IFACE = "net.hadess.PowerProfiles"


def _log():
    try:
        import decky
        return decky.logger
    except Exception:  # noqa: BLE001
        import logging
        return logging.getLogger("calvos-power-bridge")


def _levels():
    levels = dict(DEFAULT_LEVELS)
    for path in CONFIG_PATHS:
        try:
            with open(path, encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            continue
        raw = data.get("levels") if isinstance(data, dict) else None
        if not isinstance(raw, dict):
            continue
        for key, value in raw.items():
            if key in DEFAULT_LEVELS and isinstance(value, int) and not isinstance(value, bool) and 1 <= value <= 10:
                levels[key] = value
    return levels


def _read():
    try:
        out = subprocess.run(
            [BUSCTL, "--system", "get-property", DEST, PATH, IFACE, "ActiveProfile"],
            capture_output=True, text=True, timeout=5,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return None
    if len(out) > 4 and out.startswith('s "') and out.endswith('"'):
        return out[3:-1]
    return None


def start(plugin):
    """Arranca el hilo vigia. Llamar desde el bucle asyncio del plugin (en _startup)."""
    log = _log()
    levels = _levels()
    loop = asyncio.get_running_loop()

    def apply(profile):
        level = levels.get(profile)
        if level is None:
            return

        async def run():
            try:
                result = await plugin.set_tdp_watts(level, "global")
                log.info("power bridge: %s -> nivel %s (%s)", profile, level, result)
            except Exception:  # noqa: BLE001
                log.exception("power bridge: fallo aplicando %s", profile)

        asyncio.run_coroutine_threadsafe(run(), loop)

    # Al arrancar no pisamos el nivel guardado del panel salvo que el usuario haya
    # elegido explicitamente un perfil distinto del de por defecto de ppd (balanced).
    current = _read()
    if current in ("performance", "power-saver"):
        apply(current)

    def worker():
        last = current
        stop = threading.Event()
        while not stop.wait(POLL_S):
            now = _read()
            if now and now != last:
                last = now
                apply(now)

    thread = threading.Thread(target=worker, name="calvos-power-bridge", daemon=True)
    thread.start()
    log.info("power bridge: activo (ppd=%s, niveles=%s)", current, levels)
    return thread
'''


def ensure_power_bridge(plugin_dir: str) -> int:
    """Instala power_bridge.py y lo engancha en el arranque TDP de main.py (idempotente)."""
    module = os.path.join(plugin_dir, "py_modules", "power_bridge.py")
    try:
        with open(module, encoding="utf-8") as fh:
            current = fh.read()
    except OSError:
        current = None
    if current != POWER_BRIDGE_PY:
        try:
            with open(module, "w", encoding="utf-8") as fh:
                fh.write(POWER_BRIDGE_PY)
        except OSError as exc:
            log(f"ERROR escribiendo {module!r}: {exc}")
            return 1
        log(f"APLICADO: puente de energia en {module!r}")
    main = os.path.join(plugin_dir, "main.py")
    try:
        with open(main, encoding="utf-8") as fh:
            src = fh.read()
    except OSError:
        return 0
    if "power_bridge.start(self)" in src:
        return 0
    anchor = ("        await self._recover_tdp_startup_state()\n"
              "        await self._probe_tdp_backend(force=True)\n")
    if src.count(anchor) != 1:
        log("AVISO: no encuentro el arranque TDP para enganchar el puente de energia")
        return 0
    hook = (anchor +
            "        try:\n"
            "            import power_bridge\n"
            "            self._power_bridge = power_bridge.start(self)\n"
            "        except Exception:\n"
            "            decky.logger.exception(\"power bridge: no se pudo iniciar\")\n")
    new = src.replace(anchor, hook)
    try:
        ast.parse(new, filename=main)
    except SyntaxError as exc:
        log(f"ERROR: el puente deja main.py invalido: {exc}")
        return 1
    try:
        shutil.copy2(main, main + ".bak-powerbridge")
        with open(main, "w", encoding="utf-8") as fh:
            fh.write(new)
    except OSError as exc:
        log(f"ERROR escribiendo main.py: {exc}")
        return 1
    log(f"APLICADO: enganche del puente de energia en {main!r}")
    return 0


def ensure_engine4_coercion(plugin_dir: str) -> int:
    """Motor 4 (LSFG) en aarch64: al guardar el perfil tambien debe ir por la linea 5.

    En ARM no existe renderer v4 (Lossless.dll es x86): el arranque ya convierte 4->5, pero
    `save` validaba la linea 4 y fallaba con `mako_not_installed` al elegir LSFG en el panel.
    """
    path = os.path.join(plugin_dir, "py_modules", "upscalers", "mako.py")
    try:
        with open(path, encoding="utf-8") as fh:
            src = fh.read()
    except OSError:
        return 0
    if "line = 5   # en ARM no hay renderer v4" in src:
        log("ok: coerción MAKO 4->5 al guardar perfil ya presente")
        return 0
    if src.count(ENGINE4_OLD) != 1:
        log("AVISO: no encuentro el guardado del perfil de MAKO para la coerción 4->5")
        return 0
    new = src.replace(ENGINE4_OLD, ENGINE4_NEW)
    try:
        ast.parse(new, filename=path)
    except SyntaxError as exc:
        log(f"ERROR: la coerción 4->5 deja Python invalido: {exc}")
        return 1
    try:
        shutil.copy2(path, path + ".bak-engine4")
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(new)
    except OSError as exc:
        log(f"ERROR escribiendo la coerción 4->5: {exc}")
        return 1
    pyc_dir = os.path.join(plugin_dir, "py_modules", "upscalers", "__pycache__")
    for pyc in glob.glob(os.path.join(pyc_dir, "mako*.pyc")):
        try:
            os.unlink(pyc)
        except OSError:
            pass
    log(f"APLICADO: coerción MAKO 4->5 al guardar perfil en {path!r}")
    return 0


def patch_mako_arm64(plugin_dir: str) -> int:
    """MAKO en aarch64: aplica el parche de la build comunitaria (idempotente).

    El plugin se autoactualiza y cada release vuelve a traer `upscalers/mako.py` de upstream,
    que solo conoce el Renderer x86_64. El parche anade el asset aarch64 (Ken5998/mako-arm64),
    su PAYLOAD (sin lib32 ni JSON .x86) y hace que en ARM todo vaya por la linea 5.
    """
    path = os.path.join(plugin_dir, "py_modules", "upscalers", "mako.py")
    if not os.path.isfile(path):
        log(f"no existe {path!r}: nada que hacer en upscalers/mako.py")
        return 0
    try:
        with open(path, encoding="utf-8") as fh:
            src = fh.read()
    except OSError as exc:
        log(f"ERROR leyendo {path!r}: {exc}")
        return 1
    if "ASSET5_ARM" in src:
        log("ok: mako arm64 ya aplicado en upscalers/mako.py")
        return ensure_engine4_coercion(plugin_dir)
    if not os.path.isfile(ARM64_PATCH):
        log(f"ERROR: falta el parche {ARM64_PATCH!r}")
        return 1
    backup = path + ".orig-arm64"
    try:
        shutil.copy2(path, backup)
    except OSError as exc:
        log(f"ERROR creando backup {backup!r}: {exc}")
        return 1
    r = subprocess.run(["patch", "-p1", "--forward", "-d", plugin_dir, "-i", ARM64_PATCH],
                       capture_output=True, text=True)
    if r.returncode != 0:
        log(f"ERROR aplicando el parche arm64 (rc={r.returncode}): {(r.stdout + r.stderr).strip()[:300]}")
        try:
            shutil.copy2(backup, path)
        except OSError:
            pass
        return 1
    # Debe seguir siendo Python valido; si no, restauramos.
    try:
        with open(path, encoding="utf-8") as fh:
            ast.parse(fh.read(), filename=path)
    except (OSError, SyntaxError) as exc:
        log(f"ERROR: tras el parche el fichero no es Python valido, restauro: {exc}")
        try:
            shutil.copy2(backup, path)
        except OSError:
            pass
        return 1
    pyc_dir = os.path.join(plugin_dir, "py_modules", "upscalers", "__pycache__")
    for pyc in glob.glob(os.path.join(pyc_dir, "mako*.pyc")):
        try:
            os.unlink(pyc)
        except OSError:
            pass
    log(f"APLICADO: mako arm64 en {path!r} (backup: {backup!r})")
    return ensure_engine4_coercion(plugin_dir)


def main(argv: list[str]) -> int:
    path = argv[1] if len(argv) > 1 else DEFAULT_FILE
    rc = patch_file(path)
    # El plugin vive en <plugin>/py_modules/device_profiles.py
    plugin_dir = os.path.dirname(os.path.dirname(os.path.abspath(path)))
    rc2 = patch_frontend(plugin_dir)
    rc3 = patch_mako_arm64(plugin_dir)
    rc4 = ensure_power_bridge(plugin_dir)
    return rc or rc2 or rc3 or rc4


if __name__ == "__main__":
    sys.exit(main(sys.argv))
