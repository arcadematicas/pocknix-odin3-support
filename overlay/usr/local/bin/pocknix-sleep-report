#!/bin/bash
# pocknix-sleep-report — consumo de batería por suspensión.
#
# Lee /var/log/pocknix/sleep-battery.log (lo escribe el hook zz-battery-sleep) y saca
# una línea por ciclo pre/post con la duración y el %/h. Sirve para comprobar si una
# mejora de deep sleep se nota y para detectar fugas en standby.
#
# Uso:  pocknix-sleep-report [-n N]     (N = últimos ciclos, por defecto todos)

set -uo pipefail

LOG="${SLEEP_LOG:-/var/log/pocknix/sleep-battery.log}"
N=0
[ "${1:-}" = "-n" ] && N="${2:-10}"

if [ ! -r "${LOG}" ]; then
	echo "No hay log en ${LOG}. ¿Has suspendido alguna vez con el hook instalado?" >&2
	exit 1
fi

# Umbrales en %/h: por debajo de OK es normal; ALTO merece mirar; FUGA es un problema.
OK=0.60
ALTO=1.20

awk -v ok="${OK}" -v alto="${ALTO}" -v lastn="${N}" '
function fmt_dur(s) {
	h = int(s/3600); m = int((s%3600)/60)
	if (h > 0) return sprintf("%dh%02dm", h, m)
	return sprintf("%dm", m)
}
function fmt_time(t) { return strftime("%d/%m %H:%M", t) }

$2 == "pre" {
	for (i = 3; i <= NF; i++) {
		split($i, kv, "=")
		if (kv[1] == "cap") pre_cap = kv[2] + 0
		if (kv[1] == "status") pre_st = kv[2]
	}
	pre_t = $1 + 0
	have = 1
	next
}
$2 == "post" && have {
	for (i = 3; i <= NF; i++) {
		split($i, kv, "=")
		if (kv[1] == "cap") post_cap = kv[2] + 0
		if (kv[1] == "status") post_st = kv[2]
	}
	dur = ($1 + 0) - pre_t
	if (dur > 60) {
		drop = pre_cap - post_cap
		rate = (dur > 0) ? drop / (dur / 3600.0) : 0
		verdict = (rate <= ok) ? "ok" : ((rate <= alto) ? "ALTO" : "FUGA")
		if (pre_st ~ /Charg/ || post_st ~ /Charg/) verdict = "cargando"
		n++
		line[n] = sprintf("%-16s %-16s %8s  %5.1f%% -> %5.1f%%  %+6.1f%%  %5.2f %%/h  %s",
			fmt_time(pre_t), fmt_time($1 + 0), fmt_dur(dur), pre_cap, post_cap, -drop, rate, verdict)
		rates[n] = rate; verdicts[n] = verdict; drops[n] = drop; durs[n] = dur
	}
	have = 0
}
END {
	if (n == 0) { print "Sin ciclos completos pre/post todavía."; exit 0 }
	start = (lastn > 0 && n > lastn) ? n - lastn + 1 : 1
	printf "%-16s %-16s %8s  %13s  %7s  %9s  %s\n", "DORMIDA", "DESPIERTA", "DURACION", "BATERIA", "DELTA", "CONSUMO", "ESTADO"
	for (i = start; i <= n; i++) print line[i]
	printf "\nUmbrales: ok <= %.2f %%/h, ALTO <= %.2f %%/h, por encima = FUGA\n", ok, alto

	# Resumen de los ciclos válidos (sin cargar)
	v = 0; sr = 0; sd = 0
	for (i = start; i <= n; i++) if (verdicts[i] != "cargando") { v++; sr += rates[i]; sd += drops[i] }
	if (v > 0) printf "Media: %.2f %%/h en %d ciclo(s) valido(s), %.1f%% por ciclo\n", sr/v, v, sd/v
}' "${LOG}"
