#!/usr/bin/env python3
# pocknix-powerd — power button short-press => suspend (session-agnostic).
#
# WHY a daemon and not logind HandlePowerKey=suspend: on the RP6 the press that WAKES the
# device is delivered to userspace as a normal KEY_POWER after resume — that's how the old
# logind default (poweroff) shut the device down on every wake (see pocknix-bsp
# 20-pocknix-powerkey.conf). logind has no resume holdoff for the power key
# (HoldoffTimeoutSec covers lid events only), so HandlePowerKey=suspend would re-suspend
# the device on every wake press. This daemon drops any KEY_POWER within
# RESUME_IGNORE_SECS of a resume, detected clocklessly: CLOCK_BOOTTIME advances during
# suspend while CLOCK_MONOTONIC does not, so a jump in their delta == "we just resumed".
#
# Behavior split (keep in sync with pocknix-bsp/20-pocknix-powerkey.conf):
#   short press (release <= SHORT_PRESS_SECS) -> systemctl suspend   (this daemon)
#   long press  (>= 5 s)                      -> poweroff            (logind HandlePowerKeyLongPress)
#   press while asleep                        -> wake                (PMIC wakeup; kernel)
# Presses between SHORT_PRESS_SECS and 5 s do nothing — that dead zone is what keeps an
# accidental lingering press from sleeping AND from shutting down.
#
# Plasma Mobile note: the shell also reacts to KEY_POWER (display toggle/lock). That's fine
# alongside this daemon — suspend wins, and the wake press (debounced here) is what the
# shell uses to light the panel back up. powerdevil is NOT configured to suspend, so there
# is exactly one suspend requester in every session.
#
# Robustness rules inherited from pocknix-volumed: match devices by CAPABILITY (never by
# name), never exit, drop erroring fds immediately and rescan, bound every subprocess.
import os, sys, time, select, subprocess, threading
try:
    from evdev import InputDevice, list_devices, ecodes
except ImportError:
    sys.exit("pocknix-powerd: python-evdev not installed")

SHORT_PRESS_SECS   = 0.8   # release within this = "a press" -> suspend
HOLD_SECS          = 1.5   # keep it down this long = "hold" -> shutdown menu (Fransis, 14/10/2026)
SESSION_UID        = 1001  # sesion de deck: para hablar con el D-Bus de la sesion
GDBUS_TIMEOUT      = 5     # acota la llamada al menu
RESUME_IGNORE_SECS = 3.0   # swallow KEY_POWER this long after any resume
RESCAN_SECS        = 5     # re-enumerate devices that (dis)appeared
SUSPEND_TIMEOUT    = 5     # never let a stuck systemctl block the loop
STEAM_TIMEOUT      = 5     # bound the steam -ifrunning handoff
STEAM_GRACE_SECS   = 6     # let Steam draw its sleep screen before falling back
BACKLIGHT_GLOB     = "/sys/class/backlight/*/bl_power"
# Game Mode handoff. In Game Mode the power button belongs to STEAM: it draws its own
# sleep screen (the Steam logo) and suspends itself. Calling systemctl suspend straight
# away skips that UI entirely — ArmadaOS's powerbuttond does exactly this handoff
# (`steam -ifrunning steam://shortpowerpress`), which is why its suspend shows the logo.
# The session selector records the active session in SESSION_FILE; the native client
# lives under the session user's home (same contract as pocknix-steam and /usr/bin/steam).
SESSION_FILE       = os.environ.get("POCKNIX_SESSION_FILE", "/home/deck/.local/state/pocknix-session")
SESSION_USER       = os.environ.get("POCKNIX_SESSION_USER", "deck")
STEAM_DIR          = os.environ.get("POCKNIX_STEAM_DIR", f"/home/{SESSION_USER}/.local/share/Steam")
STEAM_CLIENT_DIR   = f"{STEAM_DIR}/steamrtarm64"
STEAM_CLIENT       = f"{STEAM_CLIENT_DIR}/steam"
# DRM connector DPMS ("On"/"Off"/...) is the reliable screen state. The Odin 3's backlight
# bl_power node is stuck at 4 (FB_BLANK_POWERDOWN) even when the panel is lit.
DRM_DPMS_GLOB      = "/sys/class/drm/card*-*/dpms"

# Per-event journal chatter (suspend/resume/screen-off lines) is off by default; set
# Environment=POCKNIX_POWERD_DEBUG=1 on the unit to get it back. Device-discovery and
# error lines stay unconditional.
DEBUG = os.environ.get("POCKNIX_POWERD_DEBUG", "0") == "1"

def dbg(msg):
    if DEBUG:
        print(f"pocknix-powerd: {msg}", flush=True)

def boot_mono_delta():
    return time.clock_gettime(time.CLOCK_BOOTTIME) - time.clock_gettime(time.CLOCK_MONOTONIC)

def screen_is_on():
    # Primary signal: the DRM connector DPMS state of the INTERNAL panel. The Odin 3's backlight
    # bl_power node is stuck at 4 (FB_BLANK_POWERDOWN) even when the panel is lit, so the bl_power
    # heuristic below made the daemon think the screen was always off (short press => "wake only",
    # never suspend). External/virtual connectors (DP-1, Writeback-1) report "On" with nothing
    # attached, so only DSI/eDP/LVDS count. "On" => panel on.
    import glob
    for p in glob.glob(DRM_DPMS_GLOB):
        if not any(k in p for k in ("DSI", "eDP", "LVDS")):
            continue
        try:
            if open(p).read().strip() == "On":
                return True
        except OSError:
            continue
    # Fallback: bl_power uses FB_BLANK_* (0 = FB_BLANK_UNBLANK = on; 4 = FB_BLANK_POWERDOWN). The panel is
    # "on" iff SOME backlight reports 0 — the RP6 has a real ae94000.dsi.0 node (tracks DPMS) plus
    # a legacy 'backlight' node stuck at 4, so we OR across all and only treat all-non-zero as off.
    # If we can't read any node, assume ON (fail toward the normal press=suspend behavior).
    found = False
    for p in glob.glob(BACKLIGHT_GLOB):
        found = True
        try:
            if int(open(p).read().strip()) == 0:
                return True
        except (OSError, ValueError):
            continue
    return not found   # nodes exist and none were 0 -> off; no nodes at all -> assume on

def game_mode_active():
    """True while the Game Mode session owns the display (session selector)."""
    try:
        with open(SESSION_FILE, encoding="utf-8") as fh:
            return fh.read().strip() == "gamescope"
    except OSError:
        return False

def steam_handoff(uri):
    """Hand the press to Steam. False if it could not even be delivered."""
    if not os.access(STEAM_CLIENT, os.X_OK):
        return False
    env = dict(os.environ)
    env["LD_LIBRARY_PATH"] = f"{STEAM_CLIENT_DIR}:{STEAM_DIR}/lib/aarch64-linux-gnu"
    try:
        subprocess.run([STEAM_CLIENT, "-ifrunning", f"steam://{uri}"],
                       cwd=STEAM_CLIENT_DIR, env=env, timeout=STEAM_TIMEOUT,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return True
    except (subprocess.TimeoutExpired, OSError):
        return False

def do_suspend():
    # Game Mode: let Steam show its sleep screen and suspend (it owns the power UI).
    if game_mode_active() and steam_handoff("shortpowerpress"):
        dbg("short press -> steam://shortpowerpress (Game Mode)")
        time.sleep(STEAM_GRACE_SECS)
        # If Steam ignored us (wrong UI state) don't leave the button dead: the screen
        # is still lit, so suspend ourselves. When Steam did suspend, we resume here
        # with the panel dark and must NOT suspend again.
        if not screen_is_on():
            return
        dbg("steam handoff did not suspend; falling back to systemctl")
    dbg("short press -> suspending")
    try:
        subprocess.run(["systemctl", "suspend"], timeout=SUSPEND_TIMEOUT,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, OSError):
        pass


def show_shutdown_menu():
    """Menu de apagado de KDE: el dialogo con Apagar/Reiniciar/Cerrar sesion."""
    env = dict(os.environ)
    env["XDG_RUNTIME_DIR"] = f"/run/user/{SESSION_UID}"
    env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path=/run/user/{SESSION_UID}/bus"
    try:
        subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.Shutdown",
                        "--object-path", "/Shutdown", "--method", "org.kde.Shutdown.logout"],
                       env=env, timeout=GDBUS_TIMEOUT,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def on_hold():
    """Mantener pulsado -> menu de apagado. En modo juego no hacemos nada (ahi manda Steam)."""
    if game_mode_active():
        dbg("hold en modo juego -> sin menu (Steam manda ahi)")
        return
    dbg("hold -> abriendo el menu de apagado")
    show_shutdown_menu()


def has_power_key(dev):
    return ecodes.KEY_POWER in dev.capabilities().get(ecodes.EV_KEY, [])

def scan(known_paths):
    found = {}
    for path in list_devices():
        if path in known_paths:
            continue
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        if has_power_key(dev):
            print(f"pocknix-powerd: watching {path} ({dev.name})", flush=True)
            found[path] = dev
        else:
            dev.close()
    return found

devs = {}                 # path -> InputDevice
down_at = {}              # path -> monotonic time of KEY_POWER down
last_scan = 0.0
last_delta = boot_mono_delta()
ignore_until = 0.0        # monotonic deadline; drop KEY_POWER until then

while True:
    now = time.monotonic()
    if now - last_scan >= RESCAN_SECS:
        devs.update(scan(set(devs)))
        last_scan = now
    if not devs:
        time.sleep(1)              # nothing to watch yet — wait, never exit
        continue

    hold_timer = None

    by_fd = {dev.fd: (path, dev) for path, dev in devs.items()}
    try:
        ready, _, _ = select.select(list(by_fd), [], [], RESCAN_SECS)
    except OSError:
        for dev in devs.values():
            try: dev.close()
            except OSError: pass
        devs.clear(); down_at.clear()
        last_scan = 0.0
        continue

    # Resume detection BEFORE processing events: the wake press arrives in the same loop
    # pass that follows the resume, so the debounce must be armed first.
    now = time.monotonic()
    delta = boot_mono_delta()
    if delta - last_delta > 0.5:
        ignore_until = now + RESUME_IGNORE_SECS
        down_at.clear()            # a pre-suspend down must not pair with a post-resume up
        dbg(f"resume detected — ignoring power key for {RESUME_IGNORE_SECS}s")
    last_delta = delta

    for fd in ready:
        path, dev = by_fd[fd]
        try:
            for ev in dev.read():
                if ev.type != ecodes.EV_KEY or ev.code != ecodes.KEY_POWER:
                    continue
                if now < ignore_until:
                    continue                       # wake press — swallow it
                if ev.value == 1:                  # down: start timing + armar el "mantener"
                    down_at[path] = now
                    if hold_timer is None or not hold_timer.is_alive():
                        hold_timer = threading.Timer(HOLD_SECS, on_hold)
                        hold_timer.daemon = True
                        hold_timer.start()
                elif ev.value == 0:                # up: short press => suspend
                    t0 = down_at.pop(path, None)
                    held = False
                    if hold_timer is not None:
                        held = hold_timer.finished.is_set()
                        hold_timer.cancel()
                        hold_timer = None
                    if held:
                        pass                       # mantener: ya salio el menu, no suspendemos
                    elif t0 is not None and now - t0 <= SHORT_PRESS_SECS:
                        # If the screen is already blanked (Plasma/gamescope idle timeout turned
                        # DPMS off but the system is still awake), this press is "wake the display",
                        # NOT "sleep". We don't grab the key, so the compositor gets it too and
                        # un-blanks on the input event; we just decline to suspend. First press
                        # wakes the screen, a later press (screen on) then suspends as normal.
                        if not screen_is_on():
                            dbg("screen off (idle-blank) -> wake only, not suspending")
                            continue
                        # guard the freeze window too: events queued across our own
                        # suspend get dropped even before the delta jump is seen
                        ignore_until = now + RESUME_IGNORE_SECS
                        do_suspend()
        except OSError:
            try: dev.close()
            except OSError: pass
            devs.pop(path, None); down_at.pop(path, None)
