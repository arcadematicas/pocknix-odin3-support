#!/bin/sh
# zz-power-profile — re-aplica el perfil de energia al despertar.
#
# El driver puede resetear los techos de CPU/GPU al resumir (o el devfreq puede volver a su
# OPP por defecto), igual que pasa al arrancar antes de que cargue el firmware. Se lanza el
# mismo servicio "verify" que dispara udev, en segundo plano para no retrasar el resume.
#
# Si el Panel de Control gestiona el TDP, antes de suspender se guardan SUS topes. En el
# resume, "late" aplica el perfil del sistema y la unidad "reassert" (ordenada tras ella)
# devuelve los topes del panel: el perfil no debe pisar el nivel elegido por el usuario.

case "${1:-}" in
  pre)
    [ -x /usr/local/bin/pocknix-power-profile ] && \
      /usr/local/bin/pocknix-power-profile snapshot >/dev/null 2>&1
    ;;
  post)
    /usr/bin/systemctl start --no-block pocknix-power-profile-late.service pocknix-power-profile-reassert.service >/dev/null 2>&1
    ;;
esac

exit 0
