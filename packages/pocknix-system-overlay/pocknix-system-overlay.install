# Fija el regulatory domain del WiFi en /etc/conf.d/wireless-regdom (WIRELESS_REGDOM="ES").
#
# POR QUE AQUI Y NO COMO FICHERO: /etc/conf.d/wireless-regdom es propiedad del paquete
# `wireless-regdb` (marcado backup). Si pocknix-system-overlay llevara ese fichero en el
# paquete, pacman da conflicto de ficheros ("ya existe en el sistema de archivos (es parte
# de wireless-regdb)") y romperia el build de la imagen y el -Syu (reproducido con fakeroot,
# 13/10/2026). El 85-regulatory.rules de wireless-regdb ya llama a set-wireless-regdom al
# cargarse cfg80211, asi que basta con dejar la linea activa aqui.
_pocknix_set_wireless_regdom() {
  local f="${POCKNIX_REGDOM_FILE:-/etc/conf.d/wireless-regdom}"
  local v='WIRELESS_REGDOM="ES"'
  # 1) Ya hay una linea ACTIVA -> la fijamos a ES sin tocar el resto
  if [ -f "$f" ] && grep -qE '^[[:space:]]*WIRELESS_REGDOM=' "$f"; then
    sed -i -E "s|^([[:space:]]*)WIRELESS_REGDOM=.*|\1${v}|" "$f"
  # 2) Solo esta comentada la de ES -> la descomentamos
  elif [ -f "$f" ] && grep -qE '^[[:space:]]*#[[:space:]]*WIRELESS_REGDOM="ES"' "$f"; then
    sed -i -E "s|^([[:space:]]*)#[[:space:]]*(WIRELESS_REGDOM=\"ES\")[[:space:]]*$|\1\2|" "$f"
  # 3) No existe el fichero o no hay ninguna linea -> la anadimos
  else
    printf '\n# Fijado por pocknix-system-overlay (tarea A6: 5 GHz / DFS, AP en canal 116)\n%s\n' "$v" >> "$f"
  fi
  # Lo aplica ya si el sistema esta vivo (best effort; en el chroot no pasa nada)
  command -v set-wireless-regdom >/dev/null 2>&1 && set-wireless-regdom 2>/dev/null || true
}

post_install() {
  command -v udevadm >/dev/null 2>&1 && udevadm control --reload-rules 2>/dev/null || true
  # servicios/unidades de nuestro overlay
  systemctl enable pocknix-hdr-restore.service  >/dev/null 2>&1 || true
  systemctl enable pocknix-diag.timer           >/dev/null 2>&1 || true
  systemctl enable pocknix-oobe-marker.service  >/dev/null 2>&1 || true
  # Re-aplicado del parche HDR del plugin "Panel de Control" (Hooandee, autoupdate):
  #  - .service  -> arranque al boot (wanted por multi-user.target; Before=loader)
  #  - .path     -> vigila device_profiles.py y lo reaplica cuando el updater lo pisa
  #  - .timer    -> respaldo periodico (cada 15 min) por si el inotify no ve el reemplazo
  systemctl enable pocknix-panel-control-patch.service >/dev/null 2>&1 || true
  systemctl enable pocknix-panel-control-patch.path    >/dev/null 2>&1 || true
  systemctl enable pocknix-panel-control-patch.timer   >/dev/null 2>&1 || true
  _pocknix_set_wireless_regdom
  echo "   pocknix-system-overlay: udev recargado + unidades habilitadas + regdom ES"
}
post_upgrade() { post_install; }