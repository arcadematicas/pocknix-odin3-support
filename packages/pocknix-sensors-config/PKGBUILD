# pocknix-sensors-config — configuracion del ADSP para los sensores del Odin 3 (SM8750).
#
# Extraida del firmware Android de stock (Odin3_20251206, particion vendor super_7.img):
#     debugfs -R "rdump /etc/sensors <dir>" super_7.img
# Los ficheros van a /usr/lib/firmware/sensors/ y hexagonrpcd (con -R /usr/lib/firmware) los
# sirve al ADSP como /vendor/etc/sensors/. NOMBRES ORIGINALES: el demonio pide
# `sns_reg_config` y `config/json.lst` tal cual (no renombrar).
#
# Sin esto el demonio arranca pero el ADSP no encuentra el registro y la PD no sube.
# OJO: los ficheros van PLANOS en la raiz del paquete: makepkg busca los `source=` ahi.
pkgname=pocknix-sensors-config
pkgver=20251206
pkgrel=2
pkgdesc="ADSP sensor configuration for the AYN Odin 3 (from the stock Android vendor partition)"
arch=('any')
license=('custom')
