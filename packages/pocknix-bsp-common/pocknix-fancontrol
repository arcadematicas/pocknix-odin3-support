#!/bin/sh
# pocknix-fancontrol — fan curve, run as root. Nothing else takes PWM control of the fan, so
# without this it never spins and the device cooks. /var/lib/pocknix/fan-mode is re-read every
# tick, so switching curves is a bare file write with no service restart. Curves and the quiet
# default are ROCKNIX's (their system.cfg ships cooling.profile=quiet).
#
# Per 3 s tick the fan is driven with smoothing, so it no longer jumps between curve steps:
#  * ALL cpu*/gpu* zones are read in one pass: TAVG is their mean (what the curve used to use)
#    and TMAX their maximum. TMAX is only consumed by the safety fast-path.
#  * EMA = EMA + (TAVG - EMA)/4, integer arithmetic, is the smoothed mean the curve is
#    evaluated against; EMA starts at the first TAVG. A one-tick spike moves it by a quarter.
#  * Hysteresis of 2000 mC around the levels: the curve is evaluated at EMA-2000 to allow a
#    faster level and at EMA+2000 to allow a slower one. Net effect: stepping up needs the EMA
#    a full 2000 mC above the next step's threshold, stepping down needs it 2000 mC below the
#    current step's threshold, and in between the current level is held.
#  * Ramp: the PWM actually written walks toward the target level's speed by at most +40 per
#    tick going up and -12 per tick going down (0 -> 255 is ~7 ticks = ~21 s; the slow descent
#    is what stops the fan hunting around a threshold).
#  * Safety fast-path: TMAX >= 90000 mC (90 C) forces PWM 255 at once, no ramp and no
#    hysteresis. "off" is the one exception: it keeps PWM at 0 immediately, and not even this
#    path overrides it (same promise as before).
# pwm1 is only written when the value actually changes.
#
# Charging floor (10/11/2026): /var/lib/pocknix/fan-charging holds a minimum PWM (0 = off, the
# default) that is kept while the battery says Charging/Full, awake or asleep. While asleep it is
# handed to the kernel's pwm1_sleep_charging, so a device charging in s2idle keeps airflow; at
# resume the awake speed is restored. Nothing sets it unless asked: `pocknix-fan-mode charging N`.
set -u

MODE_FILE=/var/lib/pocknix/fan-mode
GAME_MODE_FILE=/run/pocknix/game-mode
CHARGING_FILE=/var/lib/pocknix/fan-charging

FAN_PWM="$(ls /sys/class/hwmon/hwmon*/pwm1 2>/dev/null | head -1)"
[ -n "${FAN_PWM}" ] || { echo "pocknix-fancontrol: no hwmon pwm1 fan found, exiting"; exit 0; }
FAN_EN="${FAN_PWM}_enable"
# pwm-fan holds this speed while the device charges in s2idle; 0 (the kernel default) stops it.
FAN_SLEEP="${FAN_PWM}_sleep_charging"

# gpu* not gpuss*: sm8550 names its zones gpuss-N-thermal, sm8250 gpu-top-thermal.
SENSORS=""
for z in /sys/devices/virtual/thermal/thermal_zone*/; do
  case "$(cat "${z}type" 2>/dev/null)" in
    cpu*|gpu*) SENSORS="${SENSORS} ${z}temp" ;;
  esac
done
[ -n "${SENSORS}" ] || { echo "pocknix-fancontrol: no cpu/gpu thermal zones, exiting"; exit 0; }

# Charging is read from the battery's status, not a supply's online flag: a TCPM supply can stay
# online after an unplug in sleep.
BATT_STATUS=""
for p in /sys/class/power_supply/*; do
  [ "$(cat "${p}/type" 2>/dev/null)" = Battery ] && { BATT_STATUS="${p}/status"; break; }
done

# El plugin "Panel de Control" (Hooandee) tambien mueve el PWM con su curva adaptativa y su
# backend generic-pwm. Cuando esta cargado, MANDA EL: si los dos escribimos, el ventilador
# oscila y ni su curva ni la nuestra se cumplen. Decidido por Fransis (10/11/2026): todo lo
# nuestro se aparta. Este daemon se queda vivo pero sin escribir; si el panel desaparece
# (plugin desinstalado/desactivado), recupera el control solo.
PANEL_MAIN="/home/deck/homebrew/plugins/Panel de Control/main.py"
panel_active() {
  [ -f "${PANEL_MAIN}" ] || return 1
  pgrep -f "Panel de Control/main.py" >/dev/null 2>&1
}

# PWM 0-255 against millidegC, highest first; only the thresholds differ per mode.
# "off" (ROCKNIX UI + CLI, also accepted per-game) is implemented as thresholds no
# temperature can cross, so the scan below never matches and PWM stays at 0 (the SPEED
# variable's initial value): the fan is pinned off no matter how hot the SoC gets.
SPEEDS="255 204 153 119 102 77 51 0"

# Per-game override, "<pid> <fan> <lavd>" from pocknix-proton-wrapper; "-" = not overridden.
# The pid IS the game session, so a dead pid means no override and exits need no cleanup step.
effective_mode() {
  if [ -f "${GAME_MODE_FILE}" ] && read -r pid fan _ < "${GAME_MODE_FILE}"; then
    if [ -n "${pid}" ] && [ "${fan}" != "-" ] && [ -d "/proc/${pid}" ]; then
      printf '%s\n' "${fan}"
      return
    fi
  fi
  cat "${MODE_FILE}" 2>/dev/null
}

curve_temps() {
  case "${1:-$(effective_mode)}" in
    performance) echo "80000 75000 70000 65000 60000 55000 50000 0" ;;
    moderate)    echo "85000 80000 75000 70000 65000 60000 55000 0" ;;
    off)         echo "1000000 1000000 1000000 1000000 1000000 1000000 1000000 1000000" ;;  # unreachable -> SPEED stays 0
    *)           echo "95000 85000 80000 75000 70000 65000 60000 0" ;;  # quiet (default)
  esac
}

# Level index (1 = fastest ... n = slowest) for a millidegC temperature, using ${TEMPS}.
# Nothing above the lowest threshold (all of them, in "off") yields the slowest level.
level_for() {
  _t="$1"; _i=1; _n=0
  for _th in ${TEMPS}; do
    _n=$((_n + 1))
    if [ "${_t}" -gt "${_th}" ]; then printf '%s\n' "${_i}"; return 0; fi
    _i=$((_i + 1))
  done
  printf '%s\n' "${_n}"
}

# pwm1_enable: 1 = manual control, 0 = back to the hardware's automatic mode.
YIELD=0
if panel_active; then
  YIELD=1
  echo "pocknix-fancontrol: Panel de Control activo; le cedemos el ventilador" >&2
fi
[ "${YIELD}" = 0 ] && [ -e "${FAN_EN}" ] && echo 1 > "${FAN_EN}" 2>/dev/null
trap '[ "${YIELD}" = 0 ] && [ -e "${FAN_EN}" ] && echo 0 > "${FAN_EN}" 2>/dev/null; exit 0' INT TERM

# Start the ramp where the hardware already is, so the first tick does not yank the fan.
CURR=0
if HW="$(cat "${FAN_PWM}" 2>/dev/null)" && [ -n "${HW}" ]; then
  case "${HW}" in
    *[!0-9]*) ;;
    *) CURR="${HW}" ;;
  esac
fi
[ "${CURR}" -gt 255 ] && CURR=255

EMA=""; LEVEL=""; LAST_OUT=""; LAST_SC=""
while :; do
  # El panel manda: sin escribir nada mientras este cargado (ver la nota de arriba).
  if panel_active; then
    if [ "${YIELD}" = 0 ]; then
      YIELD=1
      echo "pocknix-fancontrol: Panel de Control activo; le cedemos el ventilador" >&2
    fi
    sleep 3
    continue
  elif [ "${YIELD}" = 1 ]; then
    YIELD=0
    echo "pocknix-fancontrol: Panel de Control fuera; recuperamos el ventilador" >&2
    [ -e "${FAN_EN}" ] && echo 1 > "${FAN_EN}" 2>/dev/null
  fi

  # Charging floor: hand it to the kernel once per change (it holds it through s2idle) and keep
  # it out of the curve value, so an unplug never leaves a stale floor behind.
  SC="$(cat "${CHARGING_FILE}" 2>/dev/null)"
  case "${SC}" in ''|*[!0-9]*) SC=0 ;; esac
  [ "${SC}" -gt 255 ] && SC=255
  if [ -w "${FAN_SLEEP}" ] && [ "${SC}" != "${LAST_SC}" ]; then
    echo "${SC}" > "${FAN_SLEEP}" 2>/dev/null && LAST_SC="${SC}"
  fi

  MODE="$(effective_mode)"
  TEMPS="$(curve_temps "${MODE}")"
  TSTAT="$(awk '{s+=$1; if (n==0 || $1>m) m=$1; n++}
                END {if (n) printf "%d %d", s/n, m; else printf "0 0"}' ${SENSORS} 2>/dev/null)"
  case "${TSTAT}" in
    *" "*) TAVG="${TSTAT%% *}"; TMAX="${TSTAT##* }" ;;
    *)     TAVG=0; TMAX=0 ;;
  esac

  # EMA of the mean; seeded on the very first tick.
  if [ -z "${EMA}" ]; then EMA="${TAVG}"; else EMA=$((EMA + (TAVG - EMA) / 4)); fi

  # Hysteresis: hold the level unless the EMA clears the dead band (see header).
  if [ -z "${LEVEL}" ]; then
    LEVEL="$(level_for "${EMA}")"
  else
    LUP="$(level_for $((EMA - 2000)))"
    if [ "${LUP}" -lt "${LEVEL}" ]; then LEVEL="${LUP}"; fi
    LDOWN="$(level_for $((EMA + 2000)))"
    if [ "${LDOWN}" -gt "${LEVEL}" ]; then LEVEL="${LDOWN}"; fi
  fi
  TARGET="$(echo ${SPEEDS} | cut -d' ' -f"${LEVEL}")"

  # Dangerous heat: full PWM now, bypassing ramp and hysteresis. "off" always wins with 0.
  if [ "${MODE}" = "off" ]; then
    CURR=0
  elif [ "${TMAX}" -ge 90000 ]; then
    CURR=255
  elif [ "${TARGET}" -gt "${CURR}" ]; then
    CURR=$((CURR + 40)); [ "${CURR}" -gt "${TARGET}" ] && CURR="${TARGET}"
  elif [ "${TARGET}" -lt "${CURR}" ]; then
    CURR=$((CURR - 12)); [ "${CURR}" -lt "${TARGET}" ] && CURR="${TARGET}"
  fi

  # Charging floor on top of the curve (unless the battery says it is not charging).
  OUT="${CURR}"
  if [ "${SC}" -gt "${OUT}" ]; then
    case "$(cat "${BATT_STATUS}" 2>/dev/null)" in Charging|Full|"Not charging") OUT="${SC}" ;; esac
  fi

  if [ "${OUT}" != "${LAST_OUT}" ]; then
    echo "${OUT}" > "${FAN_PWM}" 2>/dev/null
    LAST_OUT="${OUT}"
  fi
  sleep 3
done
