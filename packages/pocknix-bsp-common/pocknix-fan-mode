#!/bin/sh
# pocknix-fan-mode — get/set the pocknix-fancontrol curve (companion to pocknix-lavd-mode).
#
# The chosen mode persists across reboots in /var/lib/pocknix/fan-mode. pocknix-fancontrol
# re-reads the file every curve tick (~3s), so setting a mode is JUST the file write — no
# service restart. Curves = ROCKNIX's ("performance" = their "aggressive"); unknown/absent
# values fall back to quiet (the default).
#
#   pocknix-fan-mode                # print the current mode
#   pocknix-fan-mode moderate       # set a mode (quiet|moderate|performance|off)
#   pocknix-fan-mode charging [0-255]   # minimum speed while charging, awake or asleep (0 = off)
MODE_FILE=/var/lib/pocknix/fan-mode
PANEL_MAIN="/home/deck/homebrew/plugins/Panel de Control/main.py"

# El plugin "Panel de Control" manda sobre el ventilador cuando esta cargado (pocknix-fancontrol
# se aparta). Avisamos para que nadie piense que el ajuste no se aplico.
panel_active() {
  [ -f "${PANEL_MAIN}" ] && pgrep -f "Panel de Control/main.py" >/dev/null 2>&1
}
warn_if_panel() {
  panel_active && echo "pocknix-fan-mode: aviso: el ventilador lo gestiona Panel de Control; este ajuste no tendra efecto" >&2
  return 0
}
CHARGING_FILE=/var/lib/pocknix/fan-charging
DEFAULT=quiet

case "${1:-}" in
  "")
    m="$(cat "${MODE_FILE}" 2>/dev/null)"
    case "${m}" in quiet|moderate|performance|off) ;; *) m="${DEFAULT}" ;; esac
    printf '%s\n' "${m}"
    ;;
  quiet|moderate|performance|off)
    mkdir -p "$(dirname "${MODE_FILE}")" 2>/dev/null
    if ! printf '%s\n' "${1}" > "${MODE_FILE}" 2>/dev/null; then
      echo "pocknix-fan-mode: cannot write ${MODE_FILE} (run as root)" >&2
      exit 1
    fi
    warn_if_panel
    echo "fan mode: ${1}"
    ;;
  charging)
    if [ -z "${2:-}" ]; then
      v="$(cat "${CHARGING_FILE}" 2>/dev/null)"
      case "${v}" in ''|*[!0-9]*) v=0 ;; esac
      printf '%s\n' "${v}"
      exit 0
    fi
    case "${2}" in *[!0-9]*) echo "pocknix-fan-mode: charging takes 0-255" >&2; exit 2 ;; esac
    [ "${2}" -le 255 ] || { echo "pocknix-fan-mode: charging takes 0-255" >&2; exit 2; }
    mkdir -p "$(dirname "${CHARGING_FILE}")" 2>/dev/null
    if ! printf '%s\n' "${2}" > "${CHARGING_FILE}" 2>/dev/null; then
      echo "pocknix-fan-mode: cannot write ${CHARGING_FILE} (run as root)" >&2
      exit 1
    fi
    warn_if_panel
    echo "minimum fan speed while charging: ${2}"
    ;;
  *)
    echo "usage: pocknix-fan-mode [quiet|moderate|performance|off | charging [0-255]]" >&2
    exit 2
    ;;
esac
