From: pocknix
Subject: [PATCH] gpu_fdinfo: msm GPU temperature from the hottest gpu thermal zone

---
diff --git a/src/gpu_fdinfo.cpp b/src/gpu_fdinfo.cpp
index 4c7d07f..4ea2f30 100644
--- a/src/gpu_fdinfo.cpp
+++ b/src/gpu_fdinfo.cpp
@@ -191,9 +191,10 @@ void GPU_fdinfo::find_hwmon_sensors()
 {
     std::string hwmon;
 
-    if (module == "msm_drm" || module == "msm_dpu" )
-        hwmon = find_hwmon_sensor_dir("gpu");
-    else if (module == "panfrost" || module == "panthor")
+    if (module == "msm_drm" || module == "msm_dpu" ) {
+        find_gpu_zones();
+        return;
+    } else if (module == "panfrost" || module == "panthor")
         hwmon = find_hwmon_sensor_dir("gpu_thermal");
     else
         hwmon = find_hwmon_dir();
@@ -298,6 +299,43 @@ std::string GPU_fdinfo::find_hwmon_sensor_dir(std::string name) {
     return "";
 }
 
+// SoCs split the GPU over several thermal zones and name them differently, so
+// report the hottest zone whose hwmon name has "gpu" rather than guess one.
+void GPU_fdinfo::find_gpu_zones()
+{
+    std::error_code ec;
+    for (fs::directory_iterator it("/sys/class/hwmon", ec), end; !ec && it != end; it.increment(ec)) {
+        std::ifstream name_stream((it->path() / "name").string());
+        std::string name;
+
+        if (!std::getline(name_stream, name) || name.find("gpu") == std::string::npos)
+            continue;
+
+        std::ifstream temp((it->path() / "temp1_input").string());
+        if (temp.is_open()) {
+            SPDLOG_DEBUG("hwmon: gpu zone {} found", name);
+            gpu_zone_streams.push_back(std::move(temp));
+        }
+    }
+}
+
+int GPU_fdinfo::get_gpu_zones_temp()
+{
+    int hottest = 0;
+
+    for (auto& s : gpu_zone_streams) {
+        std::string temp_str;
+
+        s.clear();
+        s.seekg(0);
+
+        if (std::getline(s, temp_str) && !temp_str.empty())
+            hottest = std::max(hottest, std::stoi(temp_str));
+    }
+
+    return std::round(hottest / 1'000.f);
+}
+
 void GPU_fdinfo::get_current_hwmon_readings()
 {
     for (auto& hs : hwmon_sensors) {
@@ -783,7 +821,9 @@ void GPU_fdinfo::main_thread()
         metrics.CoreClock = get_gpu_clock();
         metrics.voltage = hwmon_sensors["voltage"].val;
 
-        if (module == "msm_drm")
+        if (!gpu_zone_streams.empty())
+            metrics.temp = get_gpu_zones_temp();
+        else if (module == "msm_drm")
             metrics.temp = get_kgsl_temp();
         else
             metrics.temp = hwmon_sensors["temp"].val / 1000.f;
diff --git a/src/gpu_fdinfo.h b/src/gpu_fdinfo.h
index a5b1d9e..73b8111 100644
--- a/src/gpu_fdinfo.h
+++ b/src/gpu_fdinfo.h
@@ -88,6 +88,10 @@ private:
     std::string find_hwmon_sensor_dir(std::string name);
     void get_current_hwmon_readings();
 
+    std::vector<std::ifstream> gpu_zone_streams;
+    void find_gpu_zones();
+    int get_gpu_zones_temp();
+
     float get_power_usage();
     float last_power = 0;
 
