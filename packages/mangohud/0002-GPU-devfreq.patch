From: pocknix
Subject: [PATCH] gpu_fdinfo: find the msm GPU devfreq node at runtime

---
diff --git a/src/gpu_fdinfo.cpp b/src/gpu_fdinfo.cpp
index c4d63f5..4c7d07f 100644
--- a/src/gpu_fdinfo.cpp
+++ b/src/gpu_fdinfo.cpp
@@ -655,7 +655,20 @@ float GPU_fdinfo::amdgpu_helper_get_proc_vram() {
 }
 
 void GPU_fdinfo::init_kgsl() {
-    const std::string sys_path = "/sys/class/kgsl/kgsl-3d0";
+    std::string sys_path = "/sys/class/kgsl/kgsl-3d0";
+
+    // Mainline msm has no kgsl node; its GPU devfreq is named after the DT
+    // node, "<reg address>.gpu", and the address differs between SoCs.
+    if (!fs::exists(sys_path)) {
+        std::error_code ec;
+        for (fs::directory_iterator it("/sys/class/devfreq", ec), end; !ec && it != end; it.increment(ec)) {
+            auto name = it->path().filename().string();
+            if (name.size() > 4 && name.compare(name.size() - 4, 4, ".gpu") == 0) {
+                sys_path = it->path().string();
+                break;
+            }
+        }
+    }
 
     try {
         if (!fs::exists(sys_path)) {
