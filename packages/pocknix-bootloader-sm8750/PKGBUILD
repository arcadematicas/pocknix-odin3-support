# pocknix-bootloader-sm8750 — bootloaders for SM8750 boards.
#
# boot contract (qcom-abl, still the default): XBL -> ABL -> /KERNEL (Android boot image) off the
# FAT labeled ROCKNIX. The factory ABL boots only Android, so a bootloader MUST be flashed to
# abl_a/abl_b ONCE before any SD boots — unlike sm8250, whose factory ABL chainloads UEFI GRUB. One
# elf covers the whole SM8750 family: both projects key it by SoC, not board.
# Nothing here flashes at build or install time; both flashing paths (the kit by hand from rooted
# Android, pocknix-update-abl afterwards) are deliberate user actions.
#
# TWO KITS ship side by side, and neither replaces the other:
#
#   rocknix_abl/  ROCKNIX ABL 1.1.8 — the bootloader the Odin 3 runs TODAY. Boots /KERNEL.
#                 Kept as the fallback and the way back: a device whose slots carry this elf
#                 keeps booting exactly as before, whatever BLS files are also on the FAT.
#   openabl/      OpenABL 1.2 (OpenHandheldCollective/OpenABL) — the migration target. Boots
#                 Boot Loader Spec entries: /loader/entries/*.conf, /Image and /dtbs/*.dtb,
#                 written by pocknix-bls-deploy (pocknix-bsp-common). Ignores /KERNEL.
#
# pocknix-update-abl uses the openabl kit when it is installed and only falls back to rocknix_abl
# if openabl/ is absent, so upgrading the package never silently rewrites the bootloader. Both
# kits are inert until the user flashes one.
#
# A bump must keep the ABL matched to this contract — watch ROCKNIX's own pin in
# packages/tools/rocknix-abl/package.mk when reviewing `make sync`, and OpenABL's release page.
pkgname=pocknix-bootloader-sm8750
_ablver=1.1.8
_openablver=1.2
pkgver=${_ablver}
pkgrel=2
pkgdesc="SM8750 boot payload: ROCKNIX ABL install kit (rocknix_abl) + OpenABL ${_openablver} install kit (openabl)"
arch=('aarch64')
# !strip: a stripped bootloader is an unbootable one.
options=('!strip')
url="https://github.com/shuuri-labs/pocknix-os"
license=('BSD-3-Clause')   # Qualcomm ABL (edk2 LinuxLoader); kit scripts GPL-2.0; OpenABL GPL-3.0
source=("https://github.com/ROCKNIX/abl/releases/download/v${_ablver}/rocknix-abl-v${_ablver}.tar.gz"
        "https://github.com/OpenHandheldCollective/OpenABL/releases/download/v${_openablver}/openabl-v${_openablver}.tar.gz"
        'README'
        'README.openabl'
        'flash_abl.sh.template'
        'backup_abl.sh'
        'restore_backup_abl.sh'
        '95-pocknix-abl-kit.hook')
sha512sums=('b9f9f20776ec1f8f8b2d46ef06226856d3d5c28d31701d33fca2a3f840bf393fe292e62e71a1c717726d1fd8dc6291041811afddf31d2499e59a9cbcbee764dd'
            '41f8b0460bc5c2cbbec312911377e52c41eda7c4dcd365bc76486d81cf4da0e9072df00edaf3afacb87565d856487d0aac3c8b5506d46b9ea6c901c319635492'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  # the release ships a .sha256 sidecar per elf
  ( cd "rocknix-abl-v${_ablver}" && sha256sum -c "abl_signed-SM8750.elf.sha256" )
  ( cd "openabl-v${_openablver}/SM8750" && sha256sum -c "abl_signed-SM8750.elf.sha256" )
  sed 's/%DEVICE%/SM8750/g' flash_abl.sh.template > flash_abl.sh
  # pocknix-update-abl reports the shipped version; the elf itself carries none
  echo "${_ablver}" > version

  # OpenABL kit. Its elf comes from the release tarball; the four helper files are the same
  # dd wrappers, pointed at openabl/ (the folder the user copies to Android storage) instead
  # of rocknix_abl/. Kept separate so the ROCKNIX kit stays byte-identical to what it shipped.
  mkdir -p openabl-kit
  sed -e 's|/sdcard/rocknix_abl|/sdcard/openabl|g' -e 's/%DEVICE%/SM8750/g' \
    flash_abl.sh.template > openabl-kit/flash_abl.sh
  sed 's|/sdcard/rocknix_abl|/sdcard/openabl|g' backup_abl.sh > openabl-kit/backup_abl.sh
  sed 's|/sdcard/rocknix_abl|/sdcard/openabl|g' restore_backup_abl.sh > openabl-kit/restore_backup_abl.sh
  echo "${_openablver}" > openabl-kit/version
}

package() {
  local bl="${pkgdir}/usr/share/pocknix/bootloader"

  # --- ROCKNIX ABL 1.1.8 kit (fallback, boots /KERNEL) -----------------------
  local kit="${bl}/rocknix_abl"
  install -Dm644 "rocknix-abl-v${_ablver}/abl_signed-SM8750.elf" "${kit}/abl_signed-SM8750.elf"
  install -Dm644 README                 "${kit}/README"
  install -Dm755 flash_abl.sh           "${kit}/flash_abl.sh"
  install -Dm755 backup_abl.sh          "${kit}/backup_abl.sh"
  install -Dm755 restore_backup_abl.sh  "${kit}/restore_backup_abl.sh"
  install -Dm644 version                "${kit}/version"

  # --- OpenABL 1.2 kit (migration target, boots loader/entries) --------------
  local okit="${bl}/openabl"
  install -Dm644 "openabl-v${_openablver}/SM8750/abl_signed-SM8750.elf" "${okit}/abl_signed-SM8750.elf"
  install -Dm644 README.openabl            "${okit}/README"
  install -Dm755 openabl-kit/flash_abl.sh  "${okit}/flash_abl.sh"
  install -Dm755 openabl-kit/backup_abl.sh "${okit}/backup_abl.sh"
  install -Dm755 openabl-kit/restore_backup_abl.sh "${okit}/restore_backup_abl.sh"
  install -Dm644 openabl-kit/version       "${okit}/version"

  # pacman never touches /flash, so a hook re-copies the kit there on upgrade.
  install -Dm644 "${srcdir}/95-pocknix-abl-kit.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/95-pocknix-abl-kit.hook"
}
