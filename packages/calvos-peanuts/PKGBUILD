# calvos-peanuts - Peanuts Native (Switch nativo aarch64): lanzador e integración.
#
# El AppImage NO va en el paquete: se construye con tools/peanuts-build.sh (rama del PR #130)
# y se deja en ~/Peanuts/PeanutsNative.AppImage. Este paquete instala el lanzador de escritorio,
# el entorno del mando y las dependencias que el AppImage necesita.
pkgname=calvos-peanuts
pkgver=0.1.0
pkgrel=1
pkgdesc="Peanuts Native (Switch nativo aarch64): lanzador y entorno de escritorio"
arch=('aarch64')
url="https://github.com/igawa6/peanuts-native"
license=('MIT')
depends=('zenity' 'spirv-tools' 'xcb-util-cursor' 'qt6-wayland')
options=()
source=()
sha256sums=()

package() {
  install -Dm755 "${startdir}/peanutsnative" "${pkgdir}/usr/local/bin/peanutsnative"
  install -Dm644 "${startdir}/peanutsnative.desktop" \
    "${pkgdir}/usr/share/applications/peanutsnative.desktop"
  install -Dm644 "${startdir}/10-calvos-gamepad.conf" \
    "${pkgdir}/etc/environment.d/10-calvos-gamepad.conf"
  install -Dm644 "${startdir}/peanutsnative.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/peanutsnative.png"
  install -Dm644 "${startdir}/README" "${pkgdir}/usr/share/doc/${pkgname}/README"
}
