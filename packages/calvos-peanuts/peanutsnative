#!/bin/sh
# Peanuts Native (Switch nativo aarch64) - lanzador de CalvOS.
# El AppImage viene en este paquete (/opt/peanuts); para desarrollo se puede usar
# PEANUTS_APPIMAGE o ~/Peanuts/PeanutsNative.AppImage.
APP="${PEANUTS_APPIMAGE:-/opt/peanuts/PeanutsNative.AppImage}"
if [ ! -x "$APP" ] && [ -z "${PEANUTS_APPIMAGE:-}" ] && [ -x "$HOME/Peanuts/PeanutsNative.AppImage" ]; then
    APP="$HOME/Peanuts/PeanutsNative.AppImage"
fi

if [ ! -x "$APP" ]; then
    msg="No encuentro el AppImage de Peanuts ($APP).
Reinstala calvos-peanuts (pacman -S calvos-peanuts) o construyelo con tools/peanuts-build.sh."
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="Peanuts Native" --width=480 --text="$msg" 2>/dev/null
    else
        echo "$msg" >&2
    fi
    exit 1
fi

# Qt por Wayland si la sesion es Wayland (si ya viene fijado, se respeta).
[ -n "${WAYLAND_DISPLAY:-}" ] && export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"

# En la Odin inputplumber captura el mando fisico: SDL debe usar su Xbox virtual. La sesion
# ya lo trae por /etc/environment.d; esto cubre lanzamientos fuera de sesion. Si Steam ya
# fijo su propia lista (modo juego), se respeta tal cual.
if [ -z "${SDL_GAMECONTROLLER_IGNORE_DEVICES:-}" ]; then
    export SDL_GAMECONTROLLER_IGNORE_DEVICES=0x2020/0x3001
fi

exec "$APP" "$@"
