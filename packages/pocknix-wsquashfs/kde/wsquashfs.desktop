[Desktop Entry]
Type=Service
Name=Comprimir a wsquashfs (Zstd)
ServiceTypes=KonqPopupMenu/Plugin
MimeType=inode/directory;
Actions=Comprimir;ComprimirSubcarpetas;ComprimirBorrar;
X-KDE-Priority=TopLevel
X-KDE-Submenu=wsquashfs
X-KDE-Icon=application-x-compressed-tar
X-KDE-ServiceTypes=KonqPopupMenu/Plugin

[Desktop Action Comprimir]
Name=Comprimir en wsquashfs (Zstd)
Icon=application-x-compressed-tar
Exec=/usr/local/bin/wsquashfs-menu-comprimir %F

[Desktop Action ComprimirSubcarpetas]
Name=Comprimir CADA subcarpeta en wsquashfs
Icon=application-x-compressed-tar
Exec=/usr/local/bin/wsquashfs-menu-comprimir --subcarpetas %F

[Desktop Action ComprimirBorrar]
Name=Comprimir y BORRAR el original
Icon=dialog-warning
Exec=/usr/local/bin/wsquashfs-menu-comprimir --borrar %F
