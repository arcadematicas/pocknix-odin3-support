source=()
sha256sums=()
for _c in "${_cores[@]}"; do
    source+=("${_c}_libretro.so.zip::${_base}/${_c}_libretro.so.zip")
    sha256sums+=('SKIP')
done
# Los extra, del buildbot oficial (aarch64). OJO: el buildbot sirve "lo de hoy",
# asi que estos NO estan pinnados como el set de ArkOS.
for _c in "${_cores_extra[@]}"; do
    source+=("${_c}_libretro.so.zip::${_buildbot}/${_c}_libretro.so.zip")
    sha256sums+=('SKIP')
done

package() {
  local c
  install -dm755 "${pkgdir}/usr/lib/libretro"
  for c in "${_cores[@]}" "${_cores_extra[@]}"; do
    unzip -o "${srcdir}/${c}_libretro.so.zip" -d "${pkgdir}/usr/lib/libretro/" >/dev/null
  done
  chmod 644 "${pkgdir}/usr/lib/libretro/"*.so
}
