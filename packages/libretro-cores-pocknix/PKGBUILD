# libretro-cores-pocknix — a curated aarch64 libretro core set, vendored prebuilt from
# christianhaitian/retroarch-cores (the ArkOS/TheRA set).
# Vendored because RetroArch's in-app Core Updater serves no arm64 cores: a core absent at
# image time cannot be fetched on device. They install to /usr/lib/libretro, the same path
# ALARM's libretro-* packages use, so a vendored core can be replaced transparently.
pkgname=libretro-cores-pocknix
pkgver=0.1.0
pkgrel=5
pkgdesc="Prebuilt aarch64 libretro cores (vendored, christianhaitian/ArkOS set)"
arch=('aarch64')
url="https://github.com/christianhaitian/retroarch-cores"
license=('GPL2')  # umbrella only; per-core licenses vary, some arcade cores non-commercial
depends=()
makedepends=('unzip')

# Pinned: upstream force-updates the files in place, so a floating ref is not reproducible.
_commit=913e84e8371aa252e1c520729fba04bb6a8bc1f1
_buildbot="https://buildbot.libretro.com/nightly/linux/aarch64/latest"
_base="https://raw.githubusercontent.com/christianhaitian/retroarch-cores/${_commit}/aarch64"

_cores_extra=(
    3dengine amiarcadia amiberry anarch armsx2
    bbkemu blastem boom3 bsnes-jg bsnes2014_accuracy
    bsnes2014_balanced bsnes2014_performance bsnes_cplusplus98 bsnes_mercury_accuracy bsnes_mercury_balanced
    bsnes_mercury_performance cdi2015 cemu citra citra2018
    clownmdemu desmume dice dingooemu dirksimple
    dolphin dosbox_core fixgb fixnes frodo
    fsuae galaksija gam4980 geargrafx gearlynx
    gong hatari2014 hbmame holani irogb
    jaxe jollycv jumpnbump kronos mame2003_midway
    mame2016 mednafen_gba mednafen_pce mednafen_psx mednafen_saturn
    mednafen_snes melondsds mesen-s mesen2 mojozork
    native32emu nicaiemu nside_sfc_balanced nuance oberon
    omicron openlara pcee2 pcsx2 pd777
    play pocketcdg pokketstation radio remotejoy
    rustynes skyemu spmp8000emu stella2023 superbroswar
    supermodel tamalibretro thepowdertoy tia uw8
