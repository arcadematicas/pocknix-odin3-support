# pocknix-bsp-sm8750 — board support for the SM8750 FAMILY (AYN Odin 3, KONKR Pocket FIT Elite).
# One package per SoC: board facts in /usr/lib/pocknix/boards/<board>.conf, device.conf is a
# sourced dispatcher keyed on the DT model, InputPlumber configs are dt-model gated.
#
# Input map rationale (why we ship our own ayn_mcu.yaml / 01-ayn-controller.yaml instead of
# ROCKNIX's): ROCKNIX's AYN capability map maps BTN_BACK (the physical Quick Access button) to
# keyboard KeyF1 — a key ROCKNIX's own UI uses. On a Steam Deck target that leaves Steam without
# a Quick Access button. Our map (taken from ArmadaOS, with the MangoHud paddle delta) maps
# BTN_BACK -> gamepad QuickAccess, BTN_MODE -> Guide, and the composite device targets `deck` +
# `keyboard` so Steam Input sees a Steam-native pad.
#
# No suspend quirk ships here: the SM8750 family pins s2idle in the kernel cmdline
# (mem_sleep_default=s2idle, see kernel-cmdline) — the only safe suspend mode on this SoC (deep
# wedges it) — so no sleep.conf.d drop-in is needed (unlike sm8550, whose s2idle pin lives in the BSP).
#
# pocknix-firmware-sm8750 is a REAL dep (mirrors pocknix-bsp-sm8550): it rides this dep edge to
# the fleet. `-Syu` never installs a package NAME that is not in the dependency graph, so the
# firmware blobs (the battery-auth ADSP pair, the WCN7860 wifi stack, the audio topology, the VPU
# and CDSP blobs) update on the device instead of only ever helping a freshly flashed card.
# build-image.sh's install_firmware() no longer rsyncs them into the rootfs for this SoC — see
# devices/sm8750/firmware/README.md for provenance and the `updates/` rationale.
#
# THE DAEMONS BELOW ARE OURS (arcadematicas/pocknix-odin3-support). Until 15/09/2026 they were
# installed BY HAND on the device and existed only in the support repo, so a freshly built image
# shipped without them (no OLED care, no button daemons, no power profiles, no splash, no SteamOS
# session-manager shim, no Steam UI watchdog). They are packaged here so pacman tracks them.
pkgname=pocknix-bsp-sm8750
pkgver=0.2.0
# -8: bring-up de sensores del 15/10 (pd-mapper + cadena SSC) y unidades habilitadas
# (el -7 se construyo ANTES del bring-up de sensores de la tarde).
# -10 (16/10): la cadena de sensores pasa de optdepend a DEPENDENCIA REAL. El BSP ya
#   INSTALA los drop-ins que la necesitan (pd-mapper.service.d/10-odin3.conf,
#   hexagonrpcd-adsp-sensorspd.service.d/10-tree.conf, pocknix-sensors-tree) y HABILITA
#   hexagonrpcd-adsp-sensorspd, asi que sin los paquetes el dispositivo arranca medio roto.
#   Ademas es lo que modela el grafo: `devices/sm8750/packages.list` (la via REAL de
#   instalacion de estos paquetes) NO lo recorre el gate `stage-check`, que solo sigue
#   depends+optdepends -> sin esta arista la cadena entera quedaba huerfana y no se podia
#   publicar. libqrtr entra transitivamente via pd-mapper.
#   Ver docs/CIERRE-20261016-PUBLICACION.md §4 y docs/SENSORES-ODIN3-2026-10-15.md.
# -11 (17/10): dos arreglos de la instalacion por OTA en la Odin:
#   (a) pocknix-sensors-tree.service apuntaba a /usr/bin/pocknix-sensors-tree, pero el paquete
#       instala el script en /usr/local/bin -> 203/EXEC y la cadena de sensores entera se caia
#       (sin arbol HexagonFS no hay pd-mapper ni IIO devices). Corregido el ExecStart.
#   (b) el BSP ya no instala power-button-daemon.py/-.service: los provee pocknix-system-overlay
#       (version del 14/10 con toque=suspender y mantener=menu). Tenerlos en los dos hacia que
#       pacman abortara la transaccion entera ("exists in both").
# -12 (17/10): arranque de sensores a prueba de carreras. hexagonrpcd ahora va After=pd-mapper
#   (el ADSP solo acepta INIT_ATTACH_SNS con "sensor_pd" registrado) y con Restart=always (salia
#   con codigo 0 y systemd no lo reintentaba), y iio-sensor-proxy se ordena despues del SSC
#   (enumera una sola vez al arrancar). Verificado en la Odin: rotv disponible.
# -13 (17/10): splash de arranque con el wordmark "calvOS" centrado justo debajo de "ODIN 3"
#   (antes iba en la esquina inferior derecha), algo mas pequeno. Mismas 240 frames, 46,4 MB.
# -14 (17/10): se vuelve a la ESQUINA (como el diseno anterior), calvOS algo mas pequeno (100px)
#   y con FUNDIDO de entrada (frames 70-120) para que aparezca despues de "ODIN 3". 48,4 MB.
pkgrel=16
pkgdesc="pocknix board support: SM8750 family (AYN Odin 3, KONKR Pocket FIT Elite) — board dispatch, input maps, audio UCM + Odin 3 daemons (OLED care, buttons, power/thermal, MangoHud toggle, splash, Steam UI watchdog, SteamOS session-manager shim)"
arch=('any')
url="https://github.com/arcadematicas/pocknix-odin3-support"
license=('GPL2')
# python is for the button/OLED/pergame/MangoHud daemons and the session-manager shim; sudo is
# for the sudoers.d drop-in that lets the shim switch power profiles without a password.
# pocknix-firmware-sm8750 is ours (pocknix-os localrepo), so it is visible to the build chroot.
#
# La cadena de sensores del ADSP (bring-up del 15/10) son DEPENDENCIAS REALES, no optdepends:
# este BSP instala los drop-ins que las usan (pd-mapper.service.d/10-odin3.conf,
# hexagonrpcd-adsp-sensorspd.service.d/10-tree.conf, pocknix-sensors-tree) y habilita
# hexagonrpcd-adsp-sensorspd, asi que sin los paquetes el dispositivo arranca medio roto.
# Ademas modela el grafo: `devices/sm8750/packages.list` (la via REAL de instalacion) NO lo
# recorre el gate `stage-check`, que solo sigue depends+optdepends -> sin esta arista la cadena
# entera quedaba huerfana y no se podia publicar. libqrtr entra transitivamente via pd-mapper.
# Ver docs/CIERRE-20261016-PUBLICACION.md §4 y docs/SENSORES-ODIN3-2026-10-15.md.
depends=('pocknix-bsp-common' 'pocknix-firmware-sm8750' 'python' 'sudo' 'sdl2'
          'pocknix-system-overlay'
          'hexagonrpc' 'libssc' 'msm-firmware-loader' 'pd-mapper' 'pocknix-sensors-config')
# gcc + SDL2 headers to build the OLED pixel refresher (see build()).
makedepends=('sdl2')
# Exactly one device BSP may be installed (wrong-device guard for a shared repo).
# No retired per-device BSPs exist for the SM8750 family, so no 'replaces'.
provides=('pocknix-bsp')
conflicts=('pocknix-bsp')
optdepends=('inputplumber: gamepad -> Steam Input mapping (01-ayn-controller.yaml)'
            'alsa-ucm-conf: base UCM (codec include sequences for the AYN-Odin3 UCM)'
            'mangohud: MangoHud.conf is the Odin 3 layout (compact top bar)'
            'fex-emu: /etc/environment.d/fex-fix.conf carries the steamwebhelper stability flags')
backup=('etc/sudoers.d/90-pocknix-steamos-manager'
        'etc/MangoHud/MangoHud.conf'
        'etc/environment.d/fex-fix.conf')
source=('device.conf'
        'ayn_mcu.yaml' '01-ayn-controller.yaml'
        'AYN-Odin3.conf' 'HiFi.conf'
        'kernel-cmdline')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

build() {
  # Compile the OLED pixel refresher. It is tiny (~17 KB) but it MUST be built here: the
  # original was compiled by hand ON the device and the source was never committed, so the
  # first image built from this repo shipped without it and oled-care-daemon logged
  # "Refresher finished with code 127" (command not found) — i.e. the OLED had no pixel
  # refresh at all. See oled-care/oled-refresher.c for what it does.
  gcc -Wall -O2 -o "${srcdir}/oled-refresher" "${startdir}/oled-care/oled-refresher.c" \
      $(pkg-config --cflags --libs sdl2)
}

package() {
  local sd="${startdir}"

  # --- board dispatch --------------------------------------------------------
  # boards/ is not in source= (makepkg local sources are flat): taken from startdir,
  # which build-packages.sh populates with the whole package dir.
  install -Dm644 "${srcdir}/device.conf" "${pkgdir}/usr/lib/pocknix/device.conf"
  local b
  for b in "${startdir}/boards/"*.conf; do
    install -Dm644 "${b}" "${pkgdir}/usr/lib/pocknix/boards/$(basename "${b}")"
  done

  # --- InputPlumber maps -----------------------------------------------------
  install -Dm644 "${srcdir}/01-ayn-controller.yaml" \
    "${pkgdir}/usr/share/inputplumber/devices/01-ayn-controller.yaml"
  install -Dm644 "${srcdir}/ayn_mcu.yaml" \
    "${pkgdir}/usr/share/inputplumber/capability_maps/ayn_mcu.yaml"

  # --- ALSA UCM --------------------------------------------------------------
  # The Odin 3 card reports longname "SM8750-AYN". The codec include sequences (/lib,
  # /codecs/wcd939x, /codecs/qcom-lpass) come from base alsa-ucm-conf. (ArmadaOS also ships a
  # legacy `ayn-AYNOdin3-` match name for older kernels; our longname is SM8750-AYN, so only that
  # match is installed.)
  local ucm="${pkgdir}/usr/share/alsa/ucm2"
  install -Dm644 "${srcdir}/AYN-Odin3.conf" "${ucm}/AYN/Odin3/AYN-Odin3.conf"
  install -Dm644 "${srcdir}/HiFi.conf"      "${ucm}/AYN/Odin3/HiFi.conf"
  install -d "${ucm}/conf.d/sm8750"
  ln -sf "../../AYN/Odin3/AYN-Odin3.conf" "${ucm}/conf.d/sm8750/SM8750-AYN.conf"

  # --- family kernel cmdline -------------------------------------------------
  # For the on-device /flash/KERNEL rebuild (pocknix-build-bootimg); build-packages.sh asserts it
  # matches devices/sm8750/profile.conf.
  install -Dm644 "${srcdir}/kernel-cmdline" "${pkgdir}/usr/lib/pocknix/kernel-cmdline"

  # ===========================================================================
  # OUR ADDITIONS (from here down: everything that used to be applied by hand)
  # ===========================================================================

  # --- daemons and CLI helpers -> /usr/local/bin ------------------------------
  # /usr/local/bin, not /usr/bin: device-local glue, and every unit below hardcodes that path.
  local bin="${pkgdir}/usr/local/bin"
  # power-button-daemon.py/service NO se instalan aqui: los provee pocknix-system-overlay
  # (version del 14/10: toque = suspender, mantener = menu de apagado). La copia de este BSP era
  # la vieja (solo apagaba pantalla) y ambos paquetes peleaban por la MISMA ruta -> pacman
  # abortaba la transaccion ("exists in both"). El `enable` de la unidad se mantiene aqui.
  install -Dm755 "${sd}/daemons/volume-button-daemon.py"         "${bin}/volume-button-daemon.py"
  install -Dm755 "${sd}/oled-care/oled-care-daemon.py"           "${bin}/oled-care-daemon.py"
  install -Dm755 "${sd}/oled-care/oled-refresher-auto"           "${bin}/oled-refresher-auto"
  # el binario del refresco de píxeles (compilado en build())
  install -Dm755 "${srcdir}/oled-refresher"                      "${bin}/oled-refresher"
  install -Dm755 "${sd}/mangohud/mangohud-toggle-daemon.py"      "${bin}/mangohud-toggle-daemon.py"
  install -Dm755 "${sd}/power/pocknix-power-profile"             "${bin}/pocknix-power-profile"
  install -Dm755 "${sd}/power/pocknix-cpu-governor"              "${bin}/pocknix-cpu-governor"
  install -Dm755 "${sd}/power/pocknix-pergame-power.py"          "${bin}/pocknix-pergame-power.py"
  install -Dm755 "${sd}/splash/odin3-splash-play.sh"             "${bin}/odin3-splash-play.sh"
  install -Dm755 "${sd}/splash/convert_frames.py"                "${bin}/odin3-splash-convert-frames.py"
  # Boot splash: the player streams frames.raw.zst into /dev/fb0 (one dd per frame). The raw
  # frames are 1.9 GB (240 x 8,355,840 B) — far too big for the repo AND too slow for the SD
  # (30 fps needs 250 MB/s). zstd gets them to ~45 MB because the animation is very coherent
  # between frames, and decompressing at ~1 GB/s is what makes the frame rate possible.
  # Regenerate: python3 splash/convert_frames.py (needs Pillow+numpy), then
  #   cat frames_raw/frame_*.raw | zstd -19 -T0 -o splash/frames.raw.zst
  install -Dm644 "${sd}/splash/frames.raw.zst" "${pkgdir}/usr/share/odin3-splash/frames.raw.zst"
  install -Dm755 "${sd}/steamui-watchdog/steamui-watchdog.sh"    "${bin}/steamui-watchdog.sh"
  install -Dm755 "${sd}/fake-suspend/pocknix-fake-suspend.sh"    "${bin}/pocknix-fake-suspend.sh"
  install -Dm755 "${sd}/steamos-manager/pocknix-steamos-manager" "${bin}/pocknix-steamos-manager"
  # Post-flash helper: applies the runtime tweaks that cannot be baked (masks suspend, WiFi
  # powersave off, SSH on, Plasma rotation, sensor config).
  install -Dm755 "${sd}/odin3-post-boot-setup.sh"                "${bin}/odin3-post-boot-setup.sh"
  install -Dm755 "${sd}/udev/install-odin3-gamepad-perms.sh"     "${bin}/install-odin3-gamepad-perms.sh"
  # Helper del re-escaneo de InputPlumber: lo llama la unidad .service de mas
  # abajo cuando aparece tarde el mando interno (rsinput/UART, ~15 s).
  install -Dm755 "${sd}/udev/pocknix-inputplumber-rescan.sh"     "${bin}/pocknix-inputplumber-rescan"

  # --- systemd units ----------------------------------------------------------
  local unit="${pkgdir}/usr/lib/systemd/system"
  # power-button-daemon.service lo instala pocknix-system-overlay (ver nota arriba).
  install -Dm644 "${sd}/daemons/volume-button-daemon.service"             "${unit}/volume-button-daemon.service"
  install -Dm644 "${sd}/oled-care/oled-care-daemon.service"               "${unit}/oled-care-daemon.service"
  install -Dm644 "${sd}/oled-care/oled-refresher.service"                 "${unit}/oled-refresher.service"
  install -Dm644 "${sd}/oled-care/oled-refresher.timer"                   "${unit}/oled-refresher.timer"
  install -Dm644 "${sd}/mangohud/mangohud-toggle-daemon.service"          "${unit}/mangohud-toggle-daemon.service"
  install -Dm644 "${sd}/power/pocknix-power-profile.service"              "${unit}/pocknix-power-profile.service"
  install -Dm644 "${sd}/power/pocknix-cpu-governor.service"               "${unit}/pocknix-cpu-governor.service"
  install -Dm644 "${sd}/power/pocknix-pergame-power.service"              "${unit}/pocknix-pergame-power.service"
  install -Dm644 "${sd}/splash/odin3-splash.service"                      "${unit}/odin3-splash.service"
  install -Dm644 "${sd}/steamui-watchdog/steamui-watchdog.service"        "${unit}/steamui-watchdog.service"
  install -Dm644 "${sd}/fake-suspend/pocknix-fake-suspend.service"        "${unit}/pocknix-fake-suspend.service"
  install -Dm644 "${sd}/hexagonrpcd/hexagonrpcd-adsp-sensorspd.service"   "${unit}/hexagonrpcd-adsp-sensorspd.service"
  # --- sensores del ADSP: bring-up propio del Odin 3 --------------------------
  # El SSC del ADSP necesita (a) el arbol HexagonFS en /run/msm-firmware-loader/hexagonrpc y
  # (b) que pd-mapper registre el process domain "sensor_pd" leyendo los .jsn. msm-firmware-loader
  # no puede hacer ninguna de las dos cosas en este dispositivo: no hay deteccion de slot A/B
  # (sin qbootctl ni androidboot.slot_suffix busca "dsp" en vez de "dsp_a" y solo monta persist) y
  # no existe particion "vendor" (su contenido va en super). El script cubre los dos huecos y deja
  # los .jsn donde pd-mapper los busca. Orden: loader -> tree -> {pd-mapper, hexagonrpcd}
  # (los drop-ins). Ver docs/SENSORES-ODIN3-2026-10-15.md.
  install -Dm755 "${sd}/sensors/pocknix-sensors-tree"                     "${bin}/pocknix-sensors-tree"
  install -Dm644 "${sd}/sensors/pocknix-sensors-tree.service"             "${unit}/pocknix-sensors-tree.service"
  install -Dm644 "${sd}/sensors/pd-mapper.service.d/10-odin3.conf" \
    "${pkgdir}/usr/lib/systemd/system/pd-mapper.service.d/10-odin3.conf"
  install -Dm644 "${sd}/sensors/hexagonrpcd-adsp-sensorspd.service.d/10-tree.conf" \
    "${pkgdir}/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service.d/10-tree.conf"
  install -Dm644 "${sd}/sensors/iio-sensor-proxy.service.d/10-ssc.conf" \
    "${pkgdir}/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-ssc.conf"
  install -Dm644 "${sd}/steamos-manager/pocknix-steamos-manager.service"  "${unit}/pocknix-steamos-manager.service"
  # Re-escaneo de InputPlumber cuando aparece tarde el mando interno del Odin 3.
  # NO se habilita (sin [Install]): la dispara la regla udev de mas abajo via
  # ENV{SYSTEMD_WANTS} al aparecer "AYN Odin3 Gamepad".
  install -Dm644 "${sd}/udev/pocknix-inputplumber-rescan.service"         "${unit}/pocknix-inputplumber-rescan.service"
  # Ships as 'odin3-display.service.clean' in our notes; installed under its real name.
  install -Dm644 "${sd}/odin3-display.service.clean"                      "${unit}/odin3-display.service"
  # Drop-in that adds the resume side of the fake-suspend unit (ExecStop).
  install -Dm644 "${sd}/fake-suspend/override.conf" \
    "${pkgdir}/usr/lib/systemd/system/pocknix-fake-suspend.service.d/override.conf"

  # --- dbus activation + sudoers ---------------------------------------------
  # Session-bus activation for the SteamOS session-manager shim (Steam talks to
  # com.steampowered.SteamOSManager1 for the QAM performance profiles).
  install -Dm644 "${sd}/steamos-manager/com.steampowered.SteamOSManager1.service" \
    "${pkgdir}/usr/share/dbus-1/services/com.steampowered.SteamOSManager1.service"
  # 0440 is a sudoers.d requirement (sudo skips group/world-writable files). It allows ONLY the
  # session-manager helper to switch power profiles without a password.
  install -Dm440 "${sd}/steamos-manager/90-pocknix-steamos-manager" \
    "${pkgdir}/etc/sudoers.d/90-pocknix-steamos-manager"

  # --- udev / environment / configs -------------------------------------------
  install -Dm644 "${sd}/udev/70-odin3-gamepad.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/70-odin3-gamepad.rules"
  # Re-escaneo de InputPlumber cuando aparece TARDE el mando interno del Odin 3
  # (rsinput arranca ~15 s despues que inputplumber y este no vuelve a escanear ->
  # en Steam Game Mode no hay mandos). Ver tambien 60-input-id2-odin3-gamepad.rules
  # (clasificacion ID_INPUT_JOYSTICK, vive en overlay/etc/udev/rules.d/).
  install -Dm644 "${sd}/udev/60-input-id2-odin3-gamepad-rescan.rules" \
    "${pkgdir}/usr/lib/udev/rules.d/60-input-id2-odin3-gamepad-rescan.rules"
  # FEX stability flags for steamwebhelper (x86_64 under FEX); see configs/fex-README.md.
  install -Dm644 "${sd}/configs/fex-fix.conf" \
    "${pkgdir}/etc/environment.d/fex-fix.conf"
  # Compact top-bar MangoHud layout (ROCKNIX S922X style).
  install -Dm644 "${sd}/mangohud/MangoHud.conf" \
    "${pkgdir}/etc/MangoHud/MangoHud.conf"

  # --- enable the units that declare [Install] --------------------------------
  # Done here rather than in a .install scriptlet so the symlinks are owned by the package
  # (removing it removes them).
  local want="${pkgdir}/usr/lib/systemd/system/multi-user.target.wants"
  install -d "${want}"
  local u
  # NOTE (2026-10-15): hexagonrpcd-adsp-sensorspd IS now enabled. Before it was not, because the
  # ADSP sensor PD did not come up on this SoC ("Unexpected buffer count" after INIT_ATTACH_SNS)
  # and enabling it only produced an endless restart loop (measured: 434 restarts, the only error
  # in the journal). The real cause was the missing pd-mapper: without it the ADSP never registers
  # the process domain "sensor_pd". With pd-mapper + the HexagonFS tree built by
  # pocknix-sensors-tree, the SSC exposes accelerometer, gyroscope, magnetometer and rotv
  # (verified live on the Odin). Its binary comes from the `hexagonrpc` package (/usr/bin/hexagonrpcd),
  # which is now in devices/sm8750/packages.list. See docs/SENSORES-ODIN3-2026-10-15.md.
  for u in power-button-daemon volume-button-daemon oled-care-daemon mangohud-toggle-daemon \
           pocknix-power-profile pocknix-cpu-governor pocknix-pergame-power odin3-splash \
           steamui-watchdog pocknix-sensors-tree hexagonrpcd-adsp-sensorspd; do
    ln -sf "../${u}.service" "${want}/${u}.service"
  done
  install -d "${pkgdir}/usr/lib/systemd/system/timers.target.wants"
  ln -sf "../oled-refresher.timer" \
    "${pkgdir}/usr/lib/systemd/system/timers.target.wants/oled-refresher.timer"
  install -d "${pkgdir}/usr/lib/systemd/system/systemd-suspend.service.wants"
  ln -sf "../pocknix-fake-suspend.service" \
    "${pkgdir}/usr/lib/systemd/system/systemd-suspend.service.wants/pocknix-fake-suspend.service"
  install -Dm644 "${sd}/steamos-manager/pocknix-steamos-manager.service" \
    "${pkgdir}/usr/lib/systemd/user/pocknix-steamos-manager.service"
  install -d "${pkgdir}/usr/lib/systemd/user/default.target.wants"
  ln -sf "../pocknix-steamos-manager.service" \
    "${pkgdir}/usr/lib/systemd/user/default.target.wants/pocknix-steamos-manager.service"
}
