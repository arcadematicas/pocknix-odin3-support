#!/bin/bash
# oled-refresher-auto — lanza el pixel refresher SOLO en modo juego (Steam activo).
# Evita lanzarlo en escritorio (Wayland, sin DISPLAY X11) y si ya hay uno corriendo.
#
# Ademas deja constancia del refresco en /run/pocknix/oled-care.json, el estado que
# lee el plugin PocknixControl (pestana Lighting) y que escribe oled-care-daemon.py.
# Sin esto el timer de 4 h refrescaba en modo juego pero la UI seguia diciendo
# "sin refrescos", porque el daemon nunca ve un disparo suyo (solo cuenta los suyos).

REFRESHER=/usr/local/bin/oled-refresher
DURATION=3
PASSES=3
CELL_PX=3
STATE=/run/pocknix/oled-care.json

# 1. ¿Steam activo? (modo juego)
if ! pgrep -x steam >/dev/null 2>&1; then
  exit 0
fi

# 2. ¿Ya hay un refresher corriendo?
if pgrep -x oled-refresher >/dev/null 2>&1; then
  exit 0
fi

# 3. Lanzar como deck contra el Xwayland de gamescope (:0)
sudo -u deck env DISPLAY=:0 SDL_VIDEODRIVER=x11 "$REFRESHER" "$((DURATION*PASSES))" "$CELL_PX" >/dev/null 2>&1
rc=$?

# 4. Refresco correcto -> actualizar el estado que lee el plugin. Mismo formato que
#    oled-care-daemon.py::write_state(): merge del JSON existente (el daemon deja
#    ahi "started"/"idleSeconds") + "updated", y escritura atomica.
if [ "$rc" -eq 0 ]; then
  python3 - "$STATE" <<'PY'
import json, os, sys, time

path = sys.argv[1]
try:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with open(path, "r", encoding="utf-8") as f:
            estado = json.load(f)
        if not isinstance(estado, dict):
            estado = {}
    except Exception:
        estado = {}
    now = int(time.time())
    estado["lastRefresh"] = now
    estado["lastSkip"] = None
    estado["count"] = int(estado.get("count", 0)) + 1
    estado["updated"] = now
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(estado, f)
    os.replace(tmp, path)
except Exception:
    pass
PY
fi

exit $rc
