#!/bin/sh
# pocknix-power-profile — pseudo-TDP power profiles (bajo|medio|alto) for the Odin 3
# (Snapdragon 8 Elite / SM8750). Mainline exposes no TDP/APC sysfs node for this SoC, so a
# profile is enforced as MAX-FREQUENCY CAPS: each CPU policy's scaling_max_freq plus the
# Adreno devfreq max_freq.
#
#   bajo:  every CPU cluster capped near 1.8 GHz, GPU capped at 525 MHz
#   medio: prime cluster (cpu6-7) capped near 2.85 GHz, perf cluster (cpu0-5) left at full,
#          GPU capped at 832 MHz
#   alto:  no limits — cpuinfo_max_freq on every CPU and the top OPP of the GPU
#
# The caps are picked from the kernel's own tables, so every write lands on a real OPP:
#   - CPU: scaling_available_frequencies (cap_for) or cpuinfo_max_freq (alto)
#   - GPU: available_frequencies (last token = top OPP)
#
# ORDER MATTERS (29/10/2026): the adreno driver probes early but only registers its devfreq
# and loads the firmware ~10 s later. This script used to run at boot before that, write
# nothing (the node did not exist yet) and leave the GPU at the driver default (389 MHz) and
# the prime cluster at 1.69 GHz — below what the saved profile said. That is why:
#   - "restore" tolerates a missing GPU node (boot must not hang),
#   - "verify" retries with backoff until the writes actually stick,
#   - pocknix-power-profile-late.service is fired by udev when the devfreq appears, and by
#     the system-sleep hook on resume.
#
#   pocknix-power-profile              # print the current (saved) profile
#   pocknix-power-profile bajo         # set a profile and apply it live
#   pocknix-power-profile restore      # apply the saved profile (boot; tolerates no GPU yet)
#   pocknix-power-profile verify       # apply and retry until it sticks (late service)

PROFILE_FILE=/var/lib/pocknix/power-profile
ORIG_FILE=/var/lib/pocknix/power-profile-orig
DEFAULT=alto
GPU_DEV=/sys/class/devfreq/3d00000.gpu
SNAP_FILE=/run/pocknix/tdp-caps
GPU_FULL=1100000000
PROFILES="bajo medio alto"
VERIFY_TRIES=30
VERIFY_HOLD=6

saved() {
  p="$(cat "${PROFILE_FILE}" 2>/dev/null)"
  case " ${PROFILES} " in
    *" ${p} "*) ;;
    *) p="${DEFAULT}" ;;
  esac
  printf '%s\n' "${p}"
}

# Max cap in kHz for a CPU index under a limiting profile; "alto" never calls this.
cap_for() {  # $1=profile  $2=cpu index
  case "${1}" in
    bajo)
      if [ "${2}" -lt 6 ]; then echo 1785600; else echo 1689600; fi
      ;;
    medio)
      if [ "${2}" -lt 6 ]; then echo 3532800; else echo 2841600; fi
      ;;
  esac
}

# CPU index from any /sys/devices/system/cpu/cpuN/... path (N can be multi-digit).
cpu_idx() {
  p="${1#/sys/devices/system/cpu/cpu}"
  p="${p%%/*}"
  printf '%s\n' "${p}"
}

# Top OPP the GPU can actually run at (available_frequencies is ascending).
gpu_top() {
  t=""
  if [ -r "${GPU_DEV}/available_frequencies" ]; then
    for _tok in $(cat "${GPU_DEV}/available_frequencies" 2>/dev/null); do
      t="${_tok}"
    done
  fi
  printf '%s\n' "${t:-${GPU_FULL}}"
}

want_gpu() {
  case "${1}" in
    bajo)  echo 525000000 ;;
    medio) echo 832000000 ;;
    alto)  gpu_top ;;
  esac
}

# Target cap in kHz for a CPU under a profile. "alto" goes to the real hardware maximum
# (cpuinfo_max_freq is static), NOT to the old power-profile-orig capture: that capture was
# taken while a cap was already in place (cpu7=4089600 vs 4320000 today).
want_cpu() {  # $1=profile $2=cpu index
  case "${1}" in
    alto) cat "/sys/devices/system/cpu/cpu${2}/cpufreq/cpuinfo_max_freq" 2>/dev/null ;;
    *)    cap_for "${1}" "${2}" ;;
  esac
}

# Kept for compatibility/forensics; the profiles no longer read it.
save_originals() {
  [ -f "${ORIG_FILE}" ] && return 0
  : > "${ORIG_FILE}" 2>/dev/null || return 0
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/cpuinfo_max_freq; do
    [ -r "${f}" ] || continue
    echo "cpu$(cpu_idx "${f}")=$(cat "${f}" 2>/dev/null)" >> "${ORIG_FILE}"
  done
  echo "gpu=$(gpu_top)" >> "${ORIG_FILE}"
}

write_val() {  # $1=file $2=value
  [ -w "${1}" ] || return 1
  printf '%s\n' "${2}" > "${1}" 2>/dev/null || return 1
  return 0
}

# Check WITHOUT writing. 0 when every writable CPU matches and the GPU node exists and
# matches its target.
check_profile() {
  p="${1}"
  rc=0

  if [ -e "${GPU_DEV}/max_freq" ]; then
    g="$(want_gpu "${p}")"
    [ "$(cat "${GPU_DEV}/max_freq" 2>/dev/null)" = "${g}" ] || rc=1
  else
    rc=1
  fi

  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_max_freq; do
    [ -w "${f}" ] || continue
    n="$(cpu_idx "${f}")"
    c="$(want_cpu "${p}" "${n}")"
    [ -n "${c}" ] || continue
    [ "$(cat "${f}" 2>/dev/null)" = "${c}" ] || rc=1
  done

  return "${rc}"
}

# Apply the profile and report whether it actually stuck.
# Returns 0 only when the GPU node exists AND its max_freq matches AND every writable CPU
# max matches. A missing GPU node counts as failure so "verify" keeps retrying.
apply_profile() {
  p="${1}"
  rc=0

  if [ -e "${GPU_DEV}/max_freq" ]; then
    g="$(want_gpu "${p}")"
    if [ -n "${g}" ]; then
      write_val "${GPU_DEV}/max_freq" "${g}" || rc=1
      [ "$(cat "${GPU_DEV}/max_freq" 2>/dev/null)" = "${g}" ] || rc=1
    fi
  else
    rc=1
  fi

  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_max_freq; do
    [ -w "${f}" ] || continue
    n="$(cpu_idx "${f}")"
    c="$(want_cpu "${p}" "${n}")"
    [ -n "${c}" ] || continue
    write_val "${f}" "${c}" || { rc=1; continue; }
    [ "$(cat "${f}" 2>/dev/null)" = "${c}" ] || rc=1
  done

  return "${rc}"
}

# Scheduler sched_ext recomendado por perfil. El usuario puede fijar uno a mano desde
# PocknixControl (flag /var/lib/pocknix/scx-manual): mientras exista, el perfil no toca
# el scheduler. El plugin borra el flag al volver a "auto" y re-aplica esto mismo.
apply_scx() {
  [ -x /usr/bin/pocknix-scx-mode ] || return 0
  [ -f /var/lib/pocknix/scx-manual ] && return 0
  case "${1}" in
    bajo)  /usr/bin/pocknix-scx-mode bpfland powersave >/dev/null 2>&1 || true ;;
    medio) /usr/bin/pocknix-scx-mode lavd autopilot >/dev/null 2>&1 || true ;;
    alto)  /usr/bin/pocknix-scx-mode lavd performance >/dev/null 2>&1 || true ;;
  esac
}

# El Panel de Control (Hooandee) gestiona el TDP por niveles (1-10) cuando su interruptor
# esta activo: escribe el mismo scaling_max_freq/devfreq y re-aplica su nivel al despertar.
# En ese caso el perfil del sistema (bajo/medio/alto) no debe pisarlo tras el resume.
panel_manages() {
  st="/home/deck/homebrew/settings/Panel de Control/state.json"
  [ -r "${st}" ] || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "${st}" <<'PY' >/dev/null 2>&1
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
sys.exit(0 if data.get("tdp_control_enabled", True) else 1)
PY
}

case "${1:-}" in
  "")
    saved
    ;;
  restore)
    # Nothing saved yet -> leave the boot defaults alone.
    [ -f "${PROFILE_FILE}" ] || exit 0
    # Tolerate a GPU node that does not exist yet; the late service finishes the job.
    apply_profile "$(saved)" || true
    apply_scx "$(saved)"
    ;;
  verify)
    # El adreno puede reescribir max_freq justo despues de registrarse (su OPP "sostenido"),
    # asi que no basta con aplicar y leer una vez: el valor tiene que AGUANTAR unos segundos.
    p="$(saved)"
    i=0
    while [ "${i}" -lt "${VERIFY_TRIES}" ]; do
      if apply_profile "${p}"; then
        held=1
        k=0
        while [ "${k}" -lt "${VERIFY_HOLD}" ]; do
          sleep 1
          if ! check_profile "${p}"; then held=0; break; fi
          k=$((k + 1))
        done
        if [ "${held}" = 1 ]; then
          apply_scx "${p}"
          echo "power profile: ${p} (applied and held ${VERIFY_HOLD}s after ${i}s)"
          exit 0
        fi
      fi
      i=$((i + 1))
      sleep 1
    done
    apply_scx "${p}"
    echo "pocknix-power-profile: '${p}' did not stick after ${VERIFY_TRIES}s" >&2
    exit 1
    ;;
  bajo|medio|alto)
    if [ "${1}" != alto ]; then
      save_originals
    fi
    mkdir -p "$(dirname "${PROFILE_FILE}")" 2>/dev/null
    if ! printf '%s\n' "${1}" > "${PROFILE_FILE}" 2>/dev/null; then
      echo "pocknix-power-profile: cannot write ${PROFILE_FILE} (run as root)" >&2
      exit 1
    fi
    apply_profile "${1}" || exit 1
    apply_scx "${1}"
    echo "power profile: ${1}"
    ;;
  snapshot)
    # Guarda los topes reales (los que ha puesto el Panel) antes de suspender. Solo si el
    # Panel gestiona el TDP; si no, el perfil del sistema manda y no hay nada que restaurar.
    if ! panel_manages; then
      rm -f "${SNAP_FILE}"
      exit 0
    fi
    mkdir -p "$(dirname "${SNAP_FILE}")" 2>/dev/null
    tmp="${SNAP_FILE}.tmp.$$"
    : > "${tmp}" || exit 1
    for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_max_freq; do
      [ -r "${f}" ] || continue
      v="$(cat "${f}" 2>/dev/null)"
      [ -n "${v}" ] && printf '%s %s\n' "${f}" "${v}" >> "${tmp}"
    done
    if [ -r "${GPU_DEV}/max_freq" ]; then
      v="$(cat "${GPU_DEV}/max_freq" 2>/dev/null)"
      [ -n "${v}" ] && printf '%s %s\n' "${GPU_DEV}/max_freq" "${v}" >> "${tmp}"
    fi
    mv -f "${tmp}" "${SNAP_FILE}"
    ;;
  reassert)
    # Restaura los topes guardados DESPUES de que el servicio "late" haya aplicado el perfil
    # del sistema (lo arranca la unidad reassert con After=). Reintenta unos segundos: el
    # firmware puede reescribirlos justo al resumir.
    [ -f "${SNAP_FILE}" ] || exit 0
    i=0
    ok=0
    while [ "${i}" -lt 5 ]; do
      ok=1
      while read -r f v; do
        [ -n "${f}" ] && [ -n "${v}" ] || continue
        printf '%s\n' "${v}" > "${f}" 2>/dev/null || ok=0
        [ "$(cat "${f}" 2>/dev/null)" = "${v}" ] || ok=0
      done < "${SNAP_FILE}"
      [ "${ok}" = 1 ] && break
      i=$((i + 1))
      sleep 1
    done
    rm -f "${SNAP_FILE}"
    [ "${ok}" = 1 ] || echo "pocknix-power-profile: los topes del Panel no cuajaron al resumir" >&2
    exit 0
    ;;
  *)
    echo "usage: pocknix-power-profile [bajo|medio|alto|restore|verify|snapshot|reassert]" >&2
    exit 2
    ;;
esac
