#!/bin/sh
# calvos-grabar — graba la pantalla del Odin 3 con el encoder H.264 por hardware.
#
# Dos modos, porque en modo juego hay dos "pantallas" distintas:
#   kms (defecto) : captura el SCANOUT del DPU. Sale TODO: juego + QAM + menus de Steam.
#                   Necesita root (kmsgrab), pero va en tiempo real a 1080p60.
#   x11           : captura la ventana del juego via Xwayland. NO sale el QAM ni la UI de
#                   Steam, y no necesita root.
#
# Uso:
#   calvos-grabar                  # graba hasta Ctrl+C en kms
#   calvos-grabar 30               # 30 segundos
#   calvos-grabar 30 --x11         # 30 s solo el juego
#   calvos-grabar 30 --no-audio    # sin sonido
#   calvos-grabar 30 --fps 30 --bitrate 12M --out ~/Videos
#
# Salida: ~/Videos/calvos-<fecha>.mp4 (H.264 + AAC, listo para editar/subir).
set -u

DUR=""
MODE="kms"
AUDIO=1
FPS=60
BR="25M"
OUTDIR="$HOME/Videos"
SRC_W=1920
SRC_H=1080

while [ $# -gt 0 ]; do
  case "$1" in
    --x11) MODE="x11" ;;
    --kms) MODE="kms" ;;
    --no-audio) AUDIO=0 ;;
    --fps) shift; FPS="$1" ;;
    --bitrate) shift; BR="$1" ;;
    --out) shift; OUTDIR="$1" ;;
    -h|--help) sed -n '2,25p' "$0"; exit 0 ;;
    *[!0-9]*) echo "argumento no reconocido: $1" >&2; exit 2 ;;
    *) DUR="$1" ;;
  esac
  shift
done

mkdir -p "$OUTDIR" || exit 1
OUT="$OUTDIR/calvos-$(date +%Y%m%d-%H%M%S).mp4"
export DISPLAY="${DISPLAY:-:0}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# ---- audio: monitor del sink por defecto (lo que suena, sin microfono) -------------
AUDIO_ARGS=""
if [ "$AUDIO" = "1" ]; then
  SINK=$(pactl get-default-sink 2>/dev/null)
  if [ -n "$SINK" ] && pactl list short sources 2>/dev/null | grep -q "${SINK}.monitor"; then
    AUDIO_ARGS="-f pulse -i ${SINK}.monitor -c:a aac -b:a 192k"
  fi
fi

# ---- video: encoder HW si esta, si no x264 muy rapido ------------------------------
if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q h264_v4l2m2m; then
  # el encoder de Venus exige su propio pix_fmt: no se le pasa -pix_fmt
  VENC="-c:v h264_v4l2m2m -b:v $BR"
else
  VENC="-c:v libx264 -preset ultrafast -b:v $BR -pix_fmt yuv420p"
fi

if [ "$MODE" = "kms" ]; then
  VIN="-f kmsgrab -framerate $FPS -i -"
  VF="-vf hwdownload,format=bgra,format=nv12"
  # kmsgrab necesita CAP_SYS_ADMIN: reejecuta con sudo si no somos root
  if [ "$(id -u)" -ne 0 ]; then
    echo "kms necesita root. Reintentando con sudo..."
    exec sudo -- "$0" ${DUR:+"$DUR"} --fps "$FPS" --bitrate "$BR" --out "$OUTDIR" \
      $([ "$AUDIO" = "1" ] || echo --no-audio)
  fi
else
  VIN="-f x11grab -video_size ${SRC_W}x${SRC_H} -framerate $FPS -i ${DISPLAY}"
  VF="-vf format=nv12"
fi

[ -n "$DUR" ] && DUR_ARGS="-t $DUR" || DUR_ARGS=""

echo "grabando ($MODE, ${FPS} fps, $BR) -> $OUT"
echo "  (Ctrl+C para parar)"
# shellcheck disable=SC2086
ffmpeg -hide_banner -loglevel warning -stats \
  $VIN $DUR_ARGS $VF $VENC $AUDIO_ARGS \
  -movflags +faststart -y "$OUT"
RC=$?

if [ -s "$OUT" ]; then
  echo
  echo "listo: $OUT"
  ffprobe -v error -show_entries format=duration,size:stream=codec_name,width,height,avg_frame_rate \
    -of default=noprint_wrappers=1 "$OUT" 2>/dev/null | sed 's/^/  /'
else
  echo "no se genero el fichero (rc=$RC)" >&2
  exit 1
fi
