# calvos-rustdesk - RustDesk empaquetado desde su AppImage oficial aarch64, con version y
# checksum fijados: la tienda lo ofrece en Network sin depender de descargas sin firmar.
pkgname=calvos-rustdesk
pkgver=1.5.3
pkgrel=1
pkgdesc="RustDesk (AppImage oficial aarch64): escritorio remoto"
arch=('aarch64')
url="https://rustdesk.com"
license=('AGPL-3.0-only')
depends=('fuse2' 'libpulse' 'gtk3' 'libxcb' 'libxkbcommon')
source=("rustdesk-${pkgver}-aarch64.AppImage::https://github.com/rustdesk/rustdesk/releases/download/${pkgver}/rustdesk-${pkgver}-aarch64.AppImage")
sha256sums=('924c8dee36cbd7873ba222979ea1e3274c5537c382321504edf1be824e7cde37')

package() {
  install -Dm755 "${srcdir}/rustdesk-${pkgver}-aarch64.AppImage" \
    "${pkgdir}/opt/rustdesk/rustdesk.AppImage"
  install -dm755 "${pkgdir}/usr/bin"
  printf '#!/bin/sh\nexec /opt/rustdesk/rustdesk.AppImage "$@"\n' > "${pkgdir}/usr/bin/rustdesk"
  chmod 755 "${pkgdir}/usr/bin/rustdesk"
  install -Dm644 "${startdir}/rustdesk.desktop" \
    "${pkgdir}/usr/share/applications/rustdesk.desktop"
  install -Dm644 "${startdir}/rustdesk.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/rustdesk.svg"
}
