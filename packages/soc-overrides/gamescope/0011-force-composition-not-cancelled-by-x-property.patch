-		cv_composite_force = !!get_prop( ctx, ctx->root, ctx->atoms.gamescopeCompositeForce, 0 );
+		// --force-composition wins over the property: it is the documented "disable direct
+		// scan-out" switch, and letting a client property turn it back off makes the flag
+		// unusable (Steam keeps GAMESCOPE_COMPOSITE_FORCE at 0). Without --force-composition
+		// the property still drives cv_composite_force, exactly as before.
+		if ( !bForceCompositionFromCLI )
+		{
+			cv_composite_force = !!get_prop( ctx, ctx->root, ctx->atoms.gamescopeCompositeForce, 0 );
+		}
