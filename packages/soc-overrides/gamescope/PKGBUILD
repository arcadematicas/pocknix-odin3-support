prepare() {
  cd gamescope
  git submodule update --init --recursive
  # armada (serie, en orden numerico)
  for _p in \
    0101-steamcompmgr-fallback-appid-focus \
    0102-drm-synthesize-edid-for-edidless-internal-panels \
    0103-drm-support-known-display-profiles-for-edidless-panels \
    0104-drm-compose-gamma22-hdr-without-hardware-color-management \
    0105-wsi-filter-hdr-formats-by-underlying-support \
    0106-color-scale-sdr-white-on-gamma22-hdr-output \
    0107-expose-client-sampleable-formats \
    0109-main-add-opt-in-force-vulkan-realtime \
    0110-color-fall-back-to-app-hdr-metadata-for-tonemapping \
    0111-wlserver-implement-drm-lease-v1 \
    0112-wsi-layer-pass-through-display-surface-swapchains \
    0113-feat-drm-run-a-compositor-from-the-leased-output \
    0114-wlserver-always-swallow-ignored-touch-device \
    0115-drm-blank-leased-connector-on-release \
    0116-drm-let-a-socket-lease-holder-yield-to-protocol-clients \
    0117-drm-sdr-color-management-through-dpu-output-luts \
    0118-steamcompmgr-arm64-virtual-white \
    0119-color-p3-red-is-wide-gamut \
    0121-drm-per-plane-color-management-through-msm-plane-color-pipelines ; do
    patch -p1 < "${srcdir}/${_p}.patch"
  done
  # nuestros (el 0010 va despues de 0009/0011 porque se regenero sobre esa pila)
  patch -p1 < "${srcdir}/0009-fps-limit-atom-persist.patch"
  patch -p1 < "${srcdir}/0011-force-composition-not-cancelled-by-x-property.patch"
  patch -p1 < "${srcdir}/0010-DRMBackend-add-rotated-output-max-height.patch"
}

build() {
  cd gamescope
  # gamescope and wlroots build with -Werror against older libs than ALARM ships (newer
  # libinput enums alone break -Werror=switch); appended last, these override it, and they
  # propagate into the subprojects.
  export CFLAGS+=" -Wno-error" CXXFLAGS+=" -Wno-error"
  # Appended last so -march/-mtune override ALARM's defaults, subprojects included.
  local _rocknix_tune="${POCKNIX_TUNE_CFLAGS:--march=armv9-a+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve+nosve2 -mtune=cortex-x3 -mno-outline-atomics}"
  export CFLAGS+=" ${_rocknix_tune}" CXXFLAGS+=" ${_rocknix_tune}"
  meson setup build \
    --prefix=/usr --buildtype=release -Db_lto=false \
    -Ddrm_backend=enabled \
    -Dpipewire=enabled \
    -Denable_openvr_support=false \
    -Davif_screenshots=disabled \
    -Dbenchmark=disabled \
    -Dinput_emulation=disabled \
    -Drt_cap=enabled \
    -Denable_tests=false \
    -Dsdl2_backend=enabled
  meson compile -C build
}

package() {
  cd gamescope
  meson install -C build --destdir "${pkgdir}"
}
