prepare() {
  cd gamescope
  git submodule update --init --recursive
  # Serie de armada en orden numerico. -F2 = el mismo fuzz que usa armada.
  for _p in \
    0001-steamcompmgr-fallback-appid-focus \
    0002-drm-synthesize-edid-for-edidless-internal-panels \
    0003-drm-support-known-display-profiles-for-edidless-panels \
    0004-drm-compose-gamma22-hdr-without-hardware-color-management \
    0005-wsi-filter-hdr-formats-by-underlying-support \
    0006-color-scale-sdr-white-on-gamma22-hdr-output \
    0007-expose-client-sampleable-formats \
    0009-main-add-opt-in-force-vulkan-realtime \
    0010-color-fall-back-to-app-hdr-metadata-for-tonemapping \
    0011-wlserver-implement-drm-lease-v1 \
    0012-wsi-layer-pass-through-display-surface-swapchains \
    0013-feat-drm-run-a-compositor-from-the-leased-output \
    0014-wlserver-always-swallow-ignored-touch-device \
    0015-drm-blank-leased-connector-on-release \
    0016-drm-let-a-socket-lease-holder-yield-to-protocol-clients \
    0017-drm-sdr-color-management-through-dpu-output-luts \
    0018-steamcompmgr-arm64-virtual-white \
    0019-color-p3-red-is-wide-gamut \
    0020-libliftoff-fix-multiple-primary-plane-stacking \
    0021-drm-per-plane-color-management-through-msm-plane-color-pipelines \
    0022-mangoapp-keep-a-lease-client-off-the-shared-queue \
    0023-drm-power-down-an-idle-lease-companion-output \
    0024-steamcompmgr-report-wayland-windows-to-steam \
    0025-wlserver-pass-touch-through-to-native-wayland-windows \
    0026-upscale-use-sgsr-for-sdr-fsr-requests \
    0027-steamcompmgr-elapsed-time-fps-limiter \
    0028-improve-frame-pacing \
    ; do
    patch -p1 -F2 < "${srcdir}/${_p}.patch"
  done
  # Nuestros: el 0010 va SIEMPRE al final (se regenero sobre la pila).
  patch -p1 -F2 < "${srcdir}/0010-DRMBackend-add-rotated-output-max-height.patch"
}

build() {
  cd gamescope
  # gamescope and wlroots build with -Werror against older libs than ALARM ships (newer
  # libinput enums alone break -Werror=switch); appended last, these override it, and they
  # propagate into the subprojects.
  export CFLAGS+=" -Wno-error" CXXFLAGS+=" -Wno-error"
  # Appended last so -march/-mtune override ALARM's defaults, subprojects included.
  local _rocknix_tune="${POCKNIX_TUNE_CFLAGS:--march=armv9-a+fp16+crypto+i8mm+bf16+memtag+sm4+sha3+nosve+nosve2 -mtune=cortex-x3 -mno-outline-atomics}"
  export CFLAGS+=" ${_rocknix_tune}" CXXFLAGS+=" ${_rocknix_tune}"
  meson setup build \
    --prefix=/usr --buildtype=release -Db_lto=false \
    -Ddrm_backend=enabled \
    -Dpipewire=enabled \
    -Denable_openvr_support=false \
    -Davif_screenshots=disabled \
    -Dbenchmark=disabled \
    -Dinput_emulation=disabled \
    -Drt_cap=enabled \
    -Denable_tests=false \
    -Dsdl2_backend=enabled
  meson compile -C build
}

package() {
  cd gamescope
  meson install -C build --destdir "${pkgdir}"
}
