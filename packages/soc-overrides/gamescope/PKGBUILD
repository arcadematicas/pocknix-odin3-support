# gamescope (pocknix) — base OpenGamingCollective (OGC) + parches de armada + nuestros.
#
# CAMBIO 27/09/2026: se pasa de la base ROCKNIX (Valve 3.16.25, commit 6644cc9) a la base
# OpenGamingCollective "3.16.29-ogc2" (commit 4b50dd7). Motivo: el HDR de armada (perfil
# edidless del Odin 3 + color management por plano, parche gamescope 0021) va contra esa base.
#
# La base OGC YA trae la rotacion (--force-composition-rotation, deteccion de rotacion en
# scanout: drm_plane_supported_rotations/bScanoutCanRotate/currentOutputRotation), asi que
# los parches ROCKNIX de rotacion (0007/0008) y los de touch/cursor/overlay sobran aqui.
#
# Parches de armada (rebautizados 01xx para no chocar con los nuestros):
#   0102/0103 = perfil edidless + HDR del Odin 3 (650 nits, gamma 2.2)  <- CLAVE para HDR
#   0104..0107,0110,0117,0119 = color/HDR (gamma22, tonemap, output-LUTs, P3)
#   0121 = color management POR PLANO (usa el LUTDMA del kernel 0070/0076/0077)
#   0111..0116 = DRM lease (leasing de la salida)
#   0101,0109,0118 = varios (appid fallback, vulkan realtime, virtual white ARM64)
# Nuestros: 0009 (fps-limit atom persist), 0010 (rotated-output-max-height), 0011
# (--force-composition no cancelable por la X property).
#
# epoch=1 outranks ALARM's gamescope. El pkgver DEBE vercmp-higher que la base anterior.
pkgname=gamescope
epoch=1
pkgver=3.16.29.ogc2.20260918.4b50dd7
pkgrel=1
_commit=4b50dd7a719c09acb1a0141ff6eac9dab1ab4f2f
install=gamescope.install
pkgdesc="SteamOS session compositing WM — OGC base + armada HDR patches (msm/rotated panels)"
arch=('aarch64')
url="https://github.com/OpenGamingCollective/gamescope"
license=('BSD-2-Clause')
provides=('gamescope')
conflicts=('gamescope')
depends=('wayland' 'libdrm' 'libinput' 'libxkbcommon' 'pixman' 'systemd-libs' 'libcap'
         'luajit' 'libdecor' 'libx11' 'libxext' 'libxfixes' 'libxdamage' 'libxcomposite'
         'libxrender' 'libxxf86vm' 'libxtst' 'libxi' 'libxcursor' 'libxmu' 'libxres'
         'libxcb' 'xcb-util-wm' 'seatd' 'hwdata' 'sdl2' 'pipewire' 'vulkan-icd-loader'
         'glslang' 'xorg-xwayland' 'libdisplay-info')
makedepends=('git' 'meson' 'ninja' 'cmake' 'pkgconf' 'glslang' 'vulkan-headers'
             'wayland-protocols' 'python' 'libxkbcommon' 'wayland'
             # wlroots subproject build-deps (else meson tries to build them itself):
             'xorg-xwayland' 'libdisplay-info' 'xcb-util-errors' 'xcb-util-renderutil'
             'xcb-util-image' 'xcb-util-keysyms')
source=("gamescope::git+https://github.com/OpenGamingCollective/gamescope.git#commit=${_commit}"
        # --- parches de armada (serie, en orden) ---
        '0101-steamcompmgr-fallback-appid-focus.patch'
        '0102-drm-synthesize-edid-for-edidless-internal-panels.patch'
        '0103-drm-support-known-display-profiles-for-edidless-panels.patch'
        '0104-drm-compose-gamma22-hdr-without-hardware-color-management.patch'
        '0105-wsi-filter-hdr-formats-by-underlying-support.patch'
        '0106-color-scale-sdr-white-on-gamma22-hdr-output.patch'
        '0107-expose-client-sampleable-formats.patch'
        '0109-main-add-opt-in-force-vulkan-realtime.patch'
        '0110-color-fall-back-to-app-hdr-metadata-for-tonemapping.patch'
        '0111-wlserver-implement-drm-lease-v1.patch'
        '0112-wsi-layer-pass-through-display-surface-swapchains.patch'
        '0113-feat-drm-run-a-compositor-from-the-leased-output.patch'
        '0114-wlserver-always-swallow-ignored-touch-device.patch'
        '0115-drm-blank-leased-connector-on-release.patch'
        '0116-drm-let-a-socket-lease-holder-yield-to-protocol-clients.patch'
        '0117-drm-sdr-color-management-through-dpu-output-luts.patch'
        '0118-steamcompmgr-arm64-virtual-white.patch'
        '0119-color-p3-red-is-wide-gamut.patch'
        '0121-drm-per-plane-color-management-through-msm-plane-color-pipelines.patch'
        # --- nuestros (pocknix-odin3-support) ---
        '0009-fps-limit-atom-persist.patch'
        '0011-force-composition-not-cancelled-by-x-property.patch'
        '0010-DRMBackend-add-rotated-output-max-height.patch')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
