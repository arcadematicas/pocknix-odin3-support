<?xml version="1.0"?>
<!-- This is the ES-DE find rules configuration file for Linux -->
<ruleList>
    <emulator name="OS-SHELL">
        <!-- Operating system shell -->
        <rule type="systempath">
            <entry>bash</entry>
            <entry>sh</entry>
        </rule>
    </emulator>
    <emulator name="RETROARCH">
        <rule type="systempath">
            <entry>retroarch</entry>
            <entry>org.libretro.RetroArch</entry>
        </rule>
        <rule type="staticpath">
            <entry>./Apps/RetroArch/lanzar.sh</entry>

        </rule>
    </emulator>
    <core name="RETROARCH">
        <rule type="corepath">
            <!-- Non-portable AppImage and compiled from source -->
            <entry>~/.config/retroarch/cores</entry>
            <!-- Portable, binario suelto (RetroArch del buildbot: <binario>.AppImage.home).
                 ESTA es la ruta real de DeckStation: sin ella %CORE_RETROARCH% queda
                 sin resolver y ES-DE no puede lanzar ningun juego con RetroArch. -->
            <entry>./Apps/RetroArch/retroarch.AppImage.home/.config/retroarch/cores</entry>
            <!-- Portable AppImage (layouts antiguos, se conservan por compatibilidad) -->
            <entry>./Apps/RetroArch/RetroArch-Linux-aarch64/RetroArch-Linux-aarch64.AppImage.home/.config/retroarch/cores</entry>

        </rule>
    </core>
