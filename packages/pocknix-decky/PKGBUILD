# pocknix-decky — Decky Loader (QAM plugin framework) + the Pocknix Control plugin.
# Everything ships under /usr/share; pocknix-decky-sync.service seeds deck's ~/homebrew at boot,
# version-compared so Decky's own self-updates are never downgraded.
# The plugin frontend (dist/index.js) is prebuilt and committed — no node at package build time.
pkgname=pocknix-decky
pkgver=0.1.0
# 48: the QAM update button no longer builds its own bare `pacman -Syu`; it calls
#     /usr/bin/pocknix-update (pocknix-base, now the single updater engine and owner of the
#     --overwrite policy), with a degraded in-module pacman fallback. Also appends the unit's
#     stderr to /run/pocknix-update.log so the log cannot end on an error line ahead of the
#     POCKNIX_UPDATE_EXIT marker.
# 49: ship CSS Loader (SDH-CssLoader 2.1.2, GPL) as /usr/share/decky-plugins/CSSLoader plus the
#     new pocknix-decky-theme-eclipse oneshot that installs + activates the Hooandee Eclipse
#     theme on first boot (fetched from the official catalogue and sha256-verified; the theme
#     itself is NOT redistributed). Also drops the deckthemes class-mappings snapshot at
#     /usr/share/pocknix/css_translations.json as an offline fallback for the plugin.
# 50: ship Hooandee's "Panel de Control" (v0.66.0, GPL-3.0) as /usr/share/decky-plugins/Panel de
#     Control. Unlike every other OS-shipped plugin it SELF-UPDATES on its own release cadence,
#     so pocknix-decky-sync seeds it ONLY when missing (never re-copies over the user's update);
#     see the PANEL DE CONTROL exception in that script.
pkgrel=50
pkgdesc="Decky Loader (under FEX, namespaced binfmt) + Pocknix Control + default CSS Loader theme"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL2')
depends=('fex-emu' 'fex-rootfs')
_loaderver=v3.2.9
source=('pocknix-decky-run' 'pocknix-decky-sync' 'pocknix-decky-killall' 'pocknix-decky-sync.service'
        'pocknix-decky-loader.service' 'pocknix-decky-theme-eclipse' 'pocknix-decky-theme-eclipse.service'
        'css_translations.json' 'PluginLoader.json'
        "PluginLoader-${_loaderver}::https://github.com/SteamDeckHomebrew/decky-loader/releases/download/${_loaderver}/PluginLoader")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'SKIP' 'SKIP' 'SKIP'
            '0a5246db98f2df93a6685ac8230e0acfbfa6e91d99b41b8dbbf1f94c308dedce')

package() {
  install -Dm755 "${srcdir}/PluginLoader-${_loaderver}" "${pkgdir}/usr/share/decky-loader/PluginLoader"
  printf '%s\n' "${_loaderver}" > "${srcdir}/loader.version"
  install -Dm644 "${srcdir}/loader.version"          "${pkgdir}/usr/share/decky-loader/.loader.version"

  install -Dm755 "${srcdir}/pocknix-decky-run"       "${pkgdir}/usr/lib/pocknix/pocknix-decky-run"
  install -Dm755 "${srcdir}/pocknix-decky-sync"      "${pkgdir}/usr/lib/pocknix/pocknix-decky-sync"
  install -Dm755 "${srcdir}/pocknix-decky-killall"   "${pkgdir}/usr/lib/pocknix/decky-bin/killall"
  install -Dm755 "${srcdir}/pocknix-decky-theme-eclipse" "${pkgdir}/usr/lib/pocknix/pocknix-decky-theme-eclipse"
  install -Dm644 "${srcdir}/pocknix-decky-sync.service"   "${pkgdir}/usr/lib/systemd/system/pocknix-decky-sync.service"
  install -Dm644 "${srcdir}/pocknix-decky-loader.service" "${pkgdir}/usr/lib/systemd/system/pocknix-decky-loader.service"
  install -Dm644 "${srcdir}/pocknix-decky-theme-eclipse.service" "${pkgdir}/usr/lib/systemd/system/pocknix-decky-theme-eclipse.service"
  # Decky's self-updater restarts plugin_loader.service; the symlink aliases it to ours.
  ln -s pocknix-decky-loader.service "${pkgdir}/usr/lib/systemd/system/plugin_loader.service"
  install -Dm644 "${srcdir}/PluginLoader.json"       "${pkgdir}/usr/share/fex-emu/AppConfig/PluginLoader.json"

  # Offline fallback for CSS Loader's class mappings (deckthemes stable snapshot).
  install -Dm644 "${srcdir}/css_translations.json"   "${pkgdir}/usr/share/pocknix/css_translations.json"


  local plug="${startdir}/pocknix-control" dest="${pkgdir}/usr/share/decky-plugins/PocknixControl"
  install -d -m755 "${dest}"
  cp -a "${plug}/plugin.json" "${plug}/package.json" "${plug}/main.py" "${plug}/fex-profiles.json" "${dest}/"
  cp -a "${plug}/py_modules" "${plug}/dist" "${dest}/"
  rm -f "${dest}/dist"/*.map
  find "${dest}" -name __pycache__ -type d -prune -exec rm -rf {} +

  # CSS Loader (SDH-CssLoader 2.1.2): pure Python backend + prebuilt dist JS. No native code.
  local css="${startdir}/css-loader" dest_css="${pkgdir}/usr/share/decky-plugins/CSSLoader"
  install -d -m755 "${dest_css}"
  cp -a "${css}/plugin.json" "${css}/package.json" "${css}/main.py" \
        "${css}/LICENSE" "${css}/README.md" "${dest_css}/"
  cp -a "${css}"/css_*.py "${dest_css}/"
  cp -a "${css}/dist" "${dest_css}/"
  rm -f "${dest_css}/dist"/*.map
  find "${dest_css}" -name __pycache__ -type d -prune -exec rm -rf {} +

  # Hooandee's "Panel de Control" (v0.66.0, GPL-3.0): pure Python backend + prebuilt dist JS.
  # This plugin self-updates, so pocknix-decky-sync seeds it ONLY when missing and never stomps
  # a user's own update; keep the folder name with the space — it is Decky's real plugin dir and
  # what the self-updater rewrites in place.
  local pdc="${startdir}/panel-de-control" dest_pdc="${pkgdir}/usr/share/decky-plugins/Panel de Control"
  install -d -m755 "${dest_pdc}"
  cp -a "${pdc}/." "${dest_pdc}/"
  rm -f "${dest_pdc}/dist"/*.map
  find "${dest_pdc}" -name __pycache__ -type d -prune -exec rm -rf {} +

  local mako="${startdir}/mako" dest_mako="${pkgdir}/usr/share/decky-plugins/Mako"
  install -d -m755 "${dest_mako}"
  cp -a "${mako}/plugin.json" "${mako}/package.json" "${mako}/main.py" "${mako}/shared_config.py" "${dest_mako}/"
  cp -a "${mako}/py_modules" "${mako}/dist" "${dest_mako}/"
  cp -a "${mako}/bin" "${dest_mako}/"
  rm -f "${dest_mako}/dist"/*.map
  find "${dest_mako}" -name __pycache__ -type d -prune -exec rm -rf {} +

  # LOCAL PATCH (pocknix, TEMPORARY): MAKO ships an x86_64-only Renderer and refuses
  # to run on native AArch64 hosts (see plugin/docs/ARMADA.md). The Odin 3 runs x86_64
  # games through FEX, so we force-enable MAKO there until an official AArch64 Renderer
  # ships. Two edits: declare aarch64 as a supported host (install gate) and drop the
  # runtime `uname -m` aarch64 guard from the generated wrapper (keeping the Armada
  # marker so existing wrappers are still recognised as current). REVERT when MAKO
  # supports aarch64 natively (a fresh re-vendor + dropping this patch does it).
  patch -p1 -d "${dest_mako}" < "${startdir}/mako-aarch64.patch"
}
