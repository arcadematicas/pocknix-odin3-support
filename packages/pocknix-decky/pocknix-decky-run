#!/bin/bash
# pocknix-decky-run — lanza Decky's PluginLoader, ya nativo aarch64.
#
# Hasta pkgrel 64 el loader era el binario x86_64 ejecutado bajo FEX dentro de un namespace
# privado de binfmt_misc (el global rompe el setup de compat-tool de Steam). Desde upstream
# v3.3.x hay asset `PluginLoader-arm64`, asi que se ejecuta directo: sin FEX, sin unshare y
# con autoactualizacion real (el updater de Decky descarga el asset arm64).
set -eu

exec /home/deck/homebrew/services/PluginLoader "$@"
