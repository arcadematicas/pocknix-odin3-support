// Reglas sin contrasena para las actualizaciones de cores (solo wheel).
//
// 1) pkexec de pocknix-cores-update: el helper solo toca una lista blanca de paquetes
//    (libretro-cores-pocknix, libretro-hakux), nunca paquetes arbitrarios.
// 2) Unidades transitorias pocknix-cores-update-*: el Updater de DeckStation corre DENTRO
//    del contenedor del Steam Linux Runtime (reaper), donde pkexec y sudo NO son setuid
//    ("pkexec must be setuid root"). La via que si funciona ahi es systemd-run por D-Bus,
//    y se autoriza solo para unidades con ese prefijo.
polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("wheel")) { return; }

    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/bin/pocknix-cores-update") {
        return polkit.Result.YES;
    }

    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit") || "";
        if (unit.indexOf("pocknix-cores-update-") == 0) {
            return polkit.Result.YES;
        }
    }
});
