# pocknix-steam-full — the Steam gaming-session layer. Hard depends= so
# `pacman -Rs pocknix-steam-full` removes exactly this layer. Per-SoC members (the proton
# compat tools) hang off the pocknix-device-<soc> metapackages instead.
#
# OVERRIDE NUESTRO (mantenido al portar upstream 5):
#   + pocknix-turnip-x86      payload Turnip x86 propio
#   + pocknix-vk-valve        Turnip de Valve 26.3.0-valve (+13,4% FPS medido)
#   + gamescope-session-steam sesion Steam estandar en gamescope
#   - steamos-manager         NO es paquete aqui: el servicio lo instala pocknix-bsp-sm8750
#   - pocknix-lepton          fuera: arrastra android-tools, que no esta en nuestra base (no usamos Lepton)
pkgname=pocknix-steam-full
pkgver=0.1.0
pkgrel=5
pkgdesc="pocknix optional layer: Steam gamescope session, FEX x86 runtime, Decky, Lepton"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
depends=('pocknix-steam'
         'gamescope'            # must be ours: vanilla black-screens rotated panels
         'mangohud'             # must be ours: vanilla has no Adreno sysfs reader
         'xorg-xwayland'
         'pocknix-steamos-shim'
         'pocknix-decky'
         'fex-emu'
         'fex-rootfs'
         'pocknix-turnip-arm'
         'pocknix-turnip-x86'
         'pocknix-vk-valve'
         'gamescope-session-steam')

package() {
  :   # pure metapackage
}
