#!/usr/bin/env python3
# ===========================================================================
#  pocknix-gamepad-quit — cerrar la app en curso desde el mando
# ===========================================================================
#  PROBLEMA: los emuladores standalone y las GUIs lanzadas desde ES-DE no
#  tienen forma de cerrarse. Con teclado seria Alt+F4, pero **no hay gestor de
#  ventanas** (gamescope es solo compositor, sin WM), asi que Alt+F4 no llega y
#  el usuario acaba tirando del boton de encendido.
#
#  COMPROBADO EN LA ODIN (02/10/2026, PPSSPP):
#    - Alt+F4 (xdotool key --window ... alt+F4) ....... NO cierra
#    - WM_DELETE (xdotool windowclose) ................. NO cierra
#    - SIGTERM ........................................ CIERRA ORDENADO  <-- este
#
#  QUE HACE
#    Escucha el mando fisico (sin capturarlo: el emulador sigue recibiendo sus
#    botones) y, al detectar START+SELECT, cierra la aplicacion que ES-DE haya
#    lanzado: primero SIGTERM (para que guarde), y si en TIMEOUT segundos sigue
#    viva, SIGKILL.
#
#  POR QUE "EL HIJO DE ES-DE" Y NO "LA VENTANA ACTIVA"
#    Porque el foco se queda en ES-DE; la ventana del emulador puede no tenerlo.
#    ES-DE lanza los emuladores con `Apps/<X>/lanzar.sh` (que hace exec), asi que
#    la app cuelga de ES-DE en el arbol de procesos. Se cierra TODO lo que cuelgue
#    de ES-DE, menos ES-DE.
#
#  USO
#    pocknix-gamepad-quit              # servicio: escucha el mando
#    pocknix-gamepad-quit --status     # que mando usa, que hijo cerraria
#    pocknix-gamepad-quit --once       # cierra ahora (sin mando, para probar)
#    pocknix-gamepad-quit --combo START+SELECT
#    pocknix-gamepad-quit --device "AYN Odin3 Gamepad"
# ===========================================================================
import argparse
import os
import signal
import struct
import subprocess
import sys
import time

# input_event: struct timeval (2 x long) + u16 type + u16 code + s32 value
# En aarch64 long = 8 bytes -> 8+8+2+2+4 = 24
EVENT_FMT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)
EV_SYN, EV_KEY = 0x00, 0x01

# Cdigos de boton (linux/input-event-codes.h)
BOTONES = {
    "A": 304, "B": 305, "X": 307, "Y": 308,
    "SELECT": 314, "START": 315, "MODE": 316,
    "L1": 310, "R1": 311, "L2": 312, "R2": 313,
}

TIMEOUT = 5.0          # segundos de cortesia antes del SIGKILL
ESDE_RE = "usr/bin/es-de"
VERBOSE = True


def log(*a):
    if VERBOSE:
        print(*a, flush=True)


# ---------------------------------------------------------------- busqueda del mando
def evento_del_mando(nombres):
    """Devuelve /dev/input/eventN del primer mando cuyo nombre case."""
    candidatos = []
    for entrada in sorted(os.listdir("/sys/class/input")):
        if not entrada.startswith("event"):
            continue
        ruta_nombre = "/sys/class/input/%s/device/name" % entrada
        try:
            with open(ruta_nombre) as f:
                nombre = f.read().strip()
        except OSError:
            continue
        if any(n.lower() in nombre.lower() for n in nombres):
            candidatos.append(("/dev/input/%s" % entrada, nombre))
    return candidatos


def pid_de_esde():
    try:
        salida = subprocess.run(["pgrep", "-f", ESDE_RE], capture_output=True,
                                text=True, timeout=5).stdout.split()
        return int(salida[0]) if salida else None
    except Exception:
        return None


def descendientes(pid, vistos=None):
    """Todos los procesos que cuelgan de `pid` (BFS)."""
    if vistos is None:
        vistos = set()
    cola = [pid]
    salida = []
    while cola:
        actual = cola.pop(0)
        try:
            hijos = subprocess.run(["pgrep", "-P", str(actual)], capture_output=True,
                                   text=True, timeout=5).stdout.split()
        except Exception:
            hijos = []
        for h in hijos:
            hp = int(h)
            if hp in vistos:
                continue
            vistos.add(hp)
            salida.append(hp)
            cola.append(hp)
    return salida


# ------------------------------------------------------------------------ la accion
APPS_ROOT = "/opt/deckstation"


def _es_de_deckstation(pid):
    """¿El proceso vive bajo /opt/deckstation? (los emuladores y nuestras apps, si)"""
    cmdline = exe = ""
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            cmdline = f.read().replace(b"\0", b" ").decode("utf-8", "replace")
    except OSError:
        return False
    try:
        exe = os.readlink("/proc/%d/exe" % pid)
    except OSError:
        pass
    return APPS_ROOT in cmdline or exe.startswith(APPS_ROOT)


def _bajo_su_arbol(pid, saltos=6):
    """El proceso, o alguno de sus padres, vive bajo /opt/deckstation.

    Los emuladores van dentro de un AppImage: el binario que abre la ventana vive
    en /tmp/.mount_XXXX (extraido), asi que mirando solo su exe/cmdline se
    descarta. Su padre, en cambio, es el AppImage, que si esta en /opt/deckstation.
    """
    actual = pid
    for _ in range(saltos + 1):
        if _es_de_deckstation(actual):
            return True
        try:
            with open("/proc/%d/stat" % actual) as f:
                ppid = int(f.read().split(") ")[1].split()[1])
        except (OSError, IndexError, ValueError):
            return False
        if ppid <= 1:
            return False
        actual = ppid
    return False


def pids_de_ventanas(esde=None, excluir=()):
    """PIDs de las ventanas X visibles que son de DeckStation.

    Hace falta porque la app puede NO colgar de ES-DE: si ES-DE ya no esta
    corriendo (o el lanzador se desengancha), el arbol de procesos no sirve y la
    ventana es lo unico que queda.

    FILTRO IMPORTANTE: solo se aceptan procesos que vivan bajo /opt/deckstation.
    Sin esto se colaba cualquier ventana visible (Steam, el compositor...) y el
    daemon las cerraba tambien. Aprendido a base de cerrar ventanas de Steam.
    """
    vistos = set()
    for display in (os.environ.get("DISPLAY"), ":1", ":0"):
        if not display:
            continue
        try:
            ids = subprocess.run(["xdotool", "search", "--onlyvisible", "--name", ".*"],
                                 capture_output=True, text=True, timeout=5,
                                 env=dict(os.environ, DISPLAY=display)).stdout.split()
        except Exception:
            continue
        for wid in ids:
            try:
                nombre = subprocess.run(["xdotool", "getwindowname", wid],
                                        capture_output=True, text=True, timeout=3,
                                        env=dict(os.environ, DISPLAY=display)).stdout.strip()
                pid = subprocess.run(["xdotool", "getwindowpid", wid],
                                     capture_output=True, text=True, timeout=3,
                                     env=dict(os.environ, DISPLAY=display)).stdout.strip()
            except Exception:
                continue
            if not pid or not pid.isdigit():
                continue
            p = int(pid)
            if p == esde or p in excluir or "ES-DE" in nombre:
                continue
            if not _bajo_su_arbol(p):
                log("  (salto la ventana «%s» pid %d: no es de DeckStation)" % (nombre[:40], p))
                continue
            vistos.add(p)
    return sorted(vistos)


def con_ascendientes(objetivos, esde=None):
    """Sube por el arbol hasta la RAIZ de la aplicacion y anade los eslabones.

    Los emuladores van dentro de un AppImage y ademas algunos (PPSSPP) usan un
    proceso hijo para renderizar: si solo se mata al de la ventana, el principal
    lo relanza y la app "revive". Hay que cerrar la cadena entera hasta arriba
    (sin llegar a ES-DE ni a Steam).
    """
    extra = set()
    for p in list(objetivos):
        actual = p
        for _ in range(8):
            try:
                with open("/proc/%d/stat" % actual) as f:
                    ppid = int(f.read().split(") ")[1].split()[1])
            except (OSError, IndexError, ValueError):
                break
            if ppid <= 1 or ppid == esde or ppid in objetivos or ppid in extra:
                break
            if not _bajo_su_arbol(ppid):
                break
            extra.add(ppid)
            actual = ppid
    todos = set(objetivos) | extra
    # y tambien sus descendientes, por si alguno relanza al cerrarse
    for p in list(todos):
        todos.update(descendientes(p))
    return sorted(todos)


def cerrar_app(esde, timeout=TIMEOUT):
    objetivos = []

    # 1) lo que cuelga de ES-DE (el caso normal)
    if esde:
        objetivos = descendientes(esde)
    else:
        log("  ES-DE no esta corriendo; tiro por ventana")

    # 2) ventanas X que no son ES-DE (cubre el caso de arriba y los desenganchados)
    por_ventana = pids_de_ventanas(esde, excluir=set(objetivos))
    if por_ventana:
        log("  ventanas de aplicacion: %s" % " ".join(map(str, por_ventana)))
        objetivos.extend(por_ventana)

    objetivos = [p for p in objetivos if p != os.getpid()]
    if not objetivos:
        log("  no encuentro ninguna aplicacion que cerrar (ni hijo de ES-DE ni ventana)")
        return False

    # 3) con sus padres: el runner del AppImage tambien hay que cerrarlo
    objetivos = con_ascendientes(objetivos, esde)

    log("  cerrando %d proceso(s): %s" % (len(objetivos), " ".join(map(str, objetivos))))
    for p in objetivos:
        try:
            os.kill(p, signal.SIGTERM)
        except ProcessLookupError:
            pass

    fin = time.time() + timeout
    while time.time() < fin:
        vivos = [p for p in objetivos if os.path.exists("/proc/%d" % p)]
        if not vivos:
            log("  cerrado ordenadamente ✓")
            return True
        time.sleep(0.25)

    vivos = [p for p in objetivos if os.path.exists("/proc/%d" % p)]
    if vivos:
        log("  no respondieron a SIGTERM en %ss; SIGKILL a: %s"
            % (timeout, " ".join(map(str, vivos))))
        for p in vivos:
            try:
                os.kill(p, signal.SIGKILL)
            except ProcessLookupError:
                pass
    return True


# ------------------------------------------------------------------------- el bucle
def escuchar(ruta, combo, esde=None):
    pulsados = set()
    log("  escuchando %s  (combo: %s)" % (ruta, "+".join(combo)))
    log("  pulsa %s para cerrar (Ctrl+C para salir)" % "+".join(combo))
    with open(ruta, "rb", buffering=0) as f:
        ultimo_disparo = 0.0
        while True:
            datos = f.read(EVENT_SIZE)
            if not datos or len(datos) < EVENT_SIZE:
                continue
            _s, _us, tipo, codigo, valor = struct.unpack(EVENT_FMT, datos)
            if tipo != EV_KEY:
                continue
            if valor == 1:
                pulsados.add(codigo)
            elif valor == 0:
                pulsados.discard(codigo)

            if all(BOTONES.get(b, -1) in pulsados for b in combo):
                ahora = time.time()
                if ahora - ultimo_disparo > 1.5:      # anti-rebote
                    ultimo_disparo = ahora
                    log("\n  COMBO detectado (%s)" % "+".join(combo))
                    esde = pid_de_esde()
                    cerrar_app(esde)


def main():
    global VERBOSE, TIMEOUT

    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--device", action="append", default=None,
                    help="nombre del mando (por defecto: AYN Odin3 y el virtual de InputPlumber)")
    ap.add_argument("--combo", default="START+SELECT", help="botones que disparan (por defecto START+SELECT)")
    ap.add_argument("--timeout", type=float, default=TIMEOUT, help="segundos antes de SIGKILL")
    ap.add_argument("--status", action="store_true", help="informa y sale")
    ap.add_argument("--once", action="store_true", help="cierra ahora, sin escuchar el mando")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args()

    VERBOSE = not args.quiet
    TIMEOUT = args.timeout
    combo = [c.strip().upper() for c in args.combo.split("+")]
    for c in combo:
        if c not in BOTONES:
            print("boton desconocido: %s (validos: %s)" % (c, ", ".join(sorted(BOTONES))))
            return 2

    nombres = args.device or ["AYN Odin", "Generic Steam Controller", "Microsoft X-Box"]
    encontrados = evento_del_mando(nombres)

    esde = pid_de_esde()

    if args.status:
        print("mandos encontrados:")
        for ruta, nombre in encontrados:
            print("   %-22s %s" % (ruta, nombre))
        print("ES-DE: %s" % ("pid %d" % esde if esde else "no esta corriendo"))
        if esde:
            print("cerraria: %s" % (" ".join(map(str, descendientes(esde))) or "(nada)"))
        return 0

    if args.once:
        print("cerrando lo que cuelgue de ES-DE (pid %s)..." % esde)
        cerrar_app(esde, TIMEOUT)
        return 0

    if not encontrados:
        print("no encuentro ningun mando con esos nombres. Prueba --status")
        print("  (¿estas en el grupo 'input'? Hace falta leer /dev/input/event*)")
        return 1

    # si hay varios, se escuchan todos (el fisico y el virtual de InputPlumber)
    import threading
    hilos = []
    for ruta, nombre in encontrados:
        h = threading.Thread(target=escuchar, args=(ruta, combo, esde), daemon=True)
        h.start()
        hilos.append(h)
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\n  fuera")
    return 0


if __name__ == "__main__":
    sys.exit(main())
