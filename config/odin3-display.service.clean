[Unit]
Description=ODIN 3 display: force connector on + default backlight brightness
After=multi-user.target

[Service]
Type=oneshot
# Originalmente intentaba tambien 'echo 3 > .../rotation' y cargar modulos de
# sensores/bateria. En el kernel 7.2 el rotation NO es un sysfs (es una propiedad
# DRM) y esos modulos no existen -> el servicio fallaba con status=1 sin aportar
# nada. Se dejan solo las acciones que si funcionan y son utiles.
ExecStart=/bin/bash -c "echo on > /sys/class/drm/card0-DSI-1/status 2>/dev/null; echo 3072 > /sys/class/backlight/ae94000.dsi.0/brightness 2>/dev/null; true"

[Install]
WantedBy=multi-user.target
