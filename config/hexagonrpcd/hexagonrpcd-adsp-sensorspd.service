[Unit]
Description=Hexagonrpcd ADSP SensorPD - Qualcomm Sensor Virtual FS
After=remoteproc0.service
Before=iio-sensor-proxy.service

[Service]
Type=oneshot
ExecStartPre=/bin/mkdir -p /vendor/etc/sensors /usr/lib/firmware/sensors/config /usr/lib/firmware/sensors/registry
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-adsp-secure -s -R /usr/lib/firmware
RemainAfterExit=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
