	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x08 0x01 0x0e 0x08 0x01 0x0b 0x08 0x01 0x0a 0x08>;
	};

	tpdm-cdsp-llm {
		compatible = "qcom,coresight-static-tpdm";
		qcom,cmb-element-bits = <0x20>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x141>;
					phandle = <0xe9>;
				};
			};
		};
	};

	tpdm-cdsp-llm2 {
		compatible = "qcom,coresight-static-tpdm";
		qcom,cmb-element-bits = <0x20>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x142>;
					phandle = <0xea>;
				};
			};
		};
	};

	tpdm-modem1 {
		compatible = "qcom,coresight-static-tpdm";
		qcom,dsb-element-bits = <0x20>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x143>;
					phandle = <0xda>;
				};
			};
		};
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <0x144>;
		nvmem-cell-names = "reboot-mode";
		mode-recovery = <0x01>;
		mode-bootloader = <0x02>;
		mode-edl = <0x03>;
		mode-fastboot = <0x04>;
	};

	aliases {
		serial0 = "/soc@0/geniqup@ac0000/serial@a9c000";
	};

	audio-codec {
		compatible = "qcom,wcd9395-codec", "qcom,wcd9390-codec";
		pinctrl-0 = <0x145>;
		pinctrl-names = "default";
		qcom,micbias1-microvolt = <0x1b7740>;
		qcom,micbias2-microvolt = <0x1b7740>;
		qcom,micbias3-microvolt = <0x1b7740>;
		qcom,micbias4-microvolt = <0x1b7740>;
		qcom,mbhc-buttons-vthreshold-microvolt = <0x124f8 0x249f0 0x39dc8 0x7a120 0x7a120 0x7a120 0x7a120 0x7a120>;
		qcom,mbhc-headset-vthreshold-microvolt = <0x19f0a0>;
		qcom,mbhc-headphone-vthreshold-microvolt = <0xc350>;
		qcom,rx-device = <0x146>;
		qcom,tx-device = <0x147>;
		reset-gpios = <0x62 0x65 0x01>;
		vdd-buck-supply = <0x61>;
		vdd-rxtx-supply = <0x61>;
		vdd-io-supply = <0x61>;
		vdd-mic-bias-supply = <0x127>;
		vdd-px-supply = <0x148>;
		#sound-dai-cells = <0x01>;
		mode-switch;
		orientation-switch;
		phandle = <0x14b>;

		port {

			endpoint {
				remote-endpoint = <0x149>;
				phandle = <0x64>;
			};
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			clock-frequency = <0x493e000>;
			#clock-cells = <0x00>;
			phandle = <0x123>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <0x7d00>;
			#clock-cells = <0x00>;
			phandle = <0x25>;
		};

		bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clocks = <0x71 0x00>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x24>;
		};

		bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clocks = <0x71 0x01>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x72>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x14a>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <0x73>;
			gpios = <0xc5 0x06 0x01>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};
	};

	sound {
		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
		model = "SM8750-MTP";
		audio-routing = "SpkrLeft IN", "WSA_SPK1 OUT", "SpkrRight IN", "WSA_SPK2 OUT", "IN1_HPHL", "HPHL_OUT", "IN2_HPHR", "HPHR_OUT", "AMIC2", "MIC BIAS2", "VA DMIC0", "MIC BIAS3", "VA DMIC1", "MIC BIAS3", "VA DMIC2", "MIC BIAS1", "VA DMIC3", "MIC BIAS1", "VA DMIC0", "VA MIC BIAS3", "VA DMIC1", "VA MIC BIAS3", "VA DMIC2", "VA MIC BIAS1", "VA DMIC3", "VA MIC BIAS1", "TX SWR_INPUT1", "ADC2_OUTPUT";

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			codec {
				sound-dai = <0x14b 0x00 0x14c 0x00 0x88 0x00>;
			};

			cpu {
				sound-dai = <0x14d 0x71>;
			};

			platform {
				sound-dai = <0x14e>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			codec {
				sound-dai = <0x14b 0x01 0x14f 0x00 0x8f 0x00>;
			};

			cpu {
				sound-dai = <0x14d 0x78>;
			};

			platform {
				sound-dai = <0x14e>;
			};
		};

		wsa-dai-link {
			link-name = "WSA Playback";

			codec {
				sound-dai = <0x150 0x151 0x152 0x00 0x8a 0x00>;
			};

			cpu {
				sound-dai = <0x14d 0x69>;
			};

			platform {
				sound-dai = <0x14e>;
			};
		};

		va-dai-link {
			link-name = "VA Capture";

			codec {
				sound-dai = <0x85 0x00>;
			};

			cpu {
				sound-dai = <0x14d 0x6e>;
			};

			platform {
				sound-dai = <0x14e>;
			};
		};
	};

	pmic-glink {
		compatible = "qcom,sm8750-pmic-glink", "qcom,sm8550-pmic-glink", "qcom,pmic-glink";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		orientation-gpios = <0x62 0x3d 0x00>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x153>;
						phandle = <0xa4>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x154>;
						phandle = <0x9f>;
					};
				};

				port@2 {
					reg = <0x02>;

					endpoint {
						remote-endpoint = <0x155>;
						phandle = <0x63>;
					};
				};
			};
		};
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x125>;
	};

	wcn7850-pmu {
		compatible = "qcom,wcn7850-pmu";
		pinctrl-names = "default";
		pinctrl-0 = <0x156 0x157>;
		wlan-enable-gpios = <0x62 0x10 0x00>;
		bt-enable-gpios = <0xcd 0x03 0x00>;
		vdd-supply = <0x158>;
		vddio-supply = <0x159>;
		vddio1p2-supply = <0x15a>;
		vddaon-supply = <0x15b>;
		vdddig-supply = <0x12a>;
		vddrfa1p2-supply = <0x128>;
		vddrfa1p8-supply = <0x126>;
		clocks = <0x71 0x06>;

		regulators {

			ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
				phandle = <0x41>;
			};

			ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
				phandle = <0x42>;
			};

			ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
				phandle = <0x43>;
			};

			ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
				phandle = <0x44>;
			};

			ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
				phandle = <0x45>;
			};

			ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
				phandle = <0x46>;
			};

			ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
				phandle = <0x47>;
			};

			ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
				phandle = <0x11a>;
			};

			ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
				phandle = <0x11b>;
			};
		};
	};
};
